<Window x:Class="DesktopApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - PV Generator" 
        Height="580" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Style transparent pour TextBox -->
        <Style x:Key="RoundedInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <!-- Style transparent pour PasswordBox -->
        <Style x:Key="RoundedPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="White" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#25000000" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Panneau Gauche : Illustration 3D &amp; Thème Bordeaux -->
                <ColumnDefinition Width="1.1*"/>
                <!-- Panneau Droit : Formulaire Utilisateur -->
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- PANNEAU GAUCHE (ROUGE BORDEAUX &amp; ILLUSTRATION) -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B3A3A" Offset="0"/>
                        <GradientStop Color="#6B2A2A" Offset="0.55"/>
                        <GradientStop Color="#4A1C1C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Formes de vagues décoratives (Haut-Gauche) -->
                    <Path Data="M 0,0 C 120,0 150,100 0,160 Z" Fill="White" Opacity="0.15"/>
                    <Path Data="M 0,0 C 80,0 100,60 0,110 Z" Fill="White" Opacity="0.10"/>

                    <!-- Forme de vague (Bas-Gauche) -->
                    <Path Data="M 0,550 C 150,550 200,450 0,380 Z" Fill="#2C0F0F" Opacity="0.45"/>

                    <!-- Illustration Vectorielle 3D Écran / Délibération -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Grid Width="340" Height="280">
                            <!-- Moniteur Principal -->
                            <Border Width="260" Height="175" CornerRadius="12" Background="#1E293B" BorderBrush="#94A3B8" BorderThickness="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,10,0,0">
                                <Grid Background="#0F172A">
                                    <Border Background="#1E293B" Height="24" VerticalAlignment="Top" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,5,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,5,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#10B981"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Carte d'Authentification / Cadenas Sécurisé -->
                            <Border Width="220" Height="220" CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000" Opacity="0.2"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Barre supérieure bordeaux -->
                                    <Border Background="#8B3A3A" Height="6" CornerRadius="3,3,0,0" Margin="-20,-20,-20,20"/>
                                    <!-- Icône Cadenas 3D -->
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#FDF2F2" BorderBrush="#8B3A3A" BorderThickness="3" HorizontalAlignment="Center" Margin="0,0,0,15">
                                        <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Lignes de saisie simulées -->
                                    <Border Width="130" Height="14" Background="#1E293B" CornerRadius="4" Margin="0,0,0,8"/>
                                    <Border Width="130" Height="14" Background="#8B3A3A" CornerRadius="4"/>
                                    <TextBlock Text="••••••" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-13,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Figurine d'utilisateur (User Avatar Vector) -->
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,5">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Tête -->
                                    <Ellipse Width="24" Height="24" Fill="#F87171"/>
                                    <!-- Corps / Chemise -->
                                    <Path Data="M 0,25 Q 15,10 30,25 L 30,55 L 0,55 Z" Fill="White"/>
                                    <!-- Pantalon -->
                                    <Path Data="M 0,55 L 12,90 L 18,90 L 30,55 Z" Fill="#4A1C1C"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <TextBlock Text="PV Generator Desktop" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                        <TextBlock Text="Système Officiel de Délibération &amp; PV" FontSize="13" Foreground="#F87171" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANNEAU DROIT (FORMULAIRE DE CONNEXION) -->
            <Border Grid.Column="1" Background="White" CornerRadius="0,20,20,0" ClipToBounds="True">
                <Grid>
                    <!-- Bouton Fermer (✕) en haut à droite -->
                    <Button Content="✕" Click="BtnCancel_Click" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Margin="0,15,15,0" Width="32" Height="32" 
                            Background="Transparent" Foreground="#64748B" 
                            FontSize="16" FontWeight="Bold" BorderThickness="0" 
                            Cursor="Hand" ToolTip="Quitter l'application"/>

                    <!-- Formulaire de Connexion -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Margin="30">

                        <!-- Badge Avatar Utilisateur en cercle -->
                        <Border Width="80" Height="80" CornerRadius="40" Background="#FDF2F2" BorderBrush="#8B3A3A" BorderThickness="2.5" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="👤" FontSize="36" Foreground="#8B3A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Titre Principal en Français -->
                        <TextBlock Text="CONNEXION UTILISATEUR" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Connectez-vous à votre espace délibération" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,25"/>

                        <!-- Message d'erreur s'il y a lieu -->
                        <Border Name="borderError" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock Name="txtError" Text="" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Champ NOM D'UTILISATEUR -->
                        <Border Name="borderUsername" Height="46" CornerRadius="23" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="18,0" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="txtUsername" Style="{StaticResource RoundedInputStyle}" Grid.Column="0"/>
                                <TextBlock Grid.Column="1" Text="👤" FontSize="16" Foreground="#8B3A3A" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Champ MOT DE PASSE -->
                        <Border Name="borderPassword" Height="46" CornerRadius="23" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="18,0" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <PasswordBox Name="pwdPassword" Style="{StaticResource RoundedPasswordStyle}" Grid.Column="0"/>
                                <TextBox Name="txtPasswordVisible" Style="{StaticResource RoundedInputStyle}" Grid.Column="0" Visibility="Collapsed"/>
                                
                                <Button Name="btnTogglePassword" Grid.Column="1" Content="🔒" Click="BtnTogglePassword_Click" 
                                        Background="Transparent" Foreground="#8B3A3A" FontSize="15" 
                                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Afficher/Masquer le mot de passe"/>
                            </Grid>
                        </Border>

                        <!-- Options en Français : Se Souvenir de moi &amp; Mot de passe oublié -->
                        <Grid Margin="0,0,0,25">
                            <RadioButton Content="Se souvenir de moi" IsChecked="True" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Name="btnForgotPassword" Text="Mot de passe oublié ?" MouseLeftButtonDown="BtnForgotPassword_Click" Foreground="#8B3A3A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Cliquez pour réinitialiser votre mot de passe"/>
                        </Grid>

                        <!-- Bouton d'Action (SE CONNECTER - Red Bordeaux Pill Button) -->
                        <Button Name="btnLogin" Content="SE CONNECTER" Click="BtnLogin_Click" 
                                Height="46" Foreground="White" FontSize="14" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#8B3A3A" Offset="0"/>
                                                <GradientStop Color="#6B2A2A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="23">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Color="#8B3A3A" Opacity="0.45"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Bouton Annuler masqué pour compatibilité code-behind -->
                        <Button Name="btnCancel" Click="BtnCancel_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
