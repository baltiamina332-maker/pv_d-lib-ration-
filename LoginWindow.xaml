<Window x:Class="DesktopApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Système de Génération des PV" 
        Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Style pour champs en erreur (rouge) -->
        <Style x:Key="ErrorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Error">
                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#FFEBEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style pour PasswordBox en erreur (rouge) -->
        <Style x:Key="ErrorPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <!-- En-tête -->
            <Border Background="#8B3A3A" Padding="20">
                <StackPanel>
                    <TextBlock Text="Connexion" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Système de Génération des PV de Délibération" 
                               FontSize="12" 
                               Foreground="#E8D5D5"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Opacity="0.9"/>
                </StackPanel>
            </Border>

            <!-- Formulaire de connexion -->
            <Border Background="White" Padding="30" BorderBrush="#E8EAED" BorderThickness="1,0,1,1">
                <StackPanel>
                    <!-- Nom d'utilisateur -->
                    <TextBlock Text="Nom d'utilisateur" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBox Name="txtUsername" 
                             Style="{StaticResource ErrorTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <PasswordBox Grid.Column="0"
                                     Name="pwdPassword" 
                                     Style="{StaticResource ErrorPasswordBoxStyle}"/>
                        
                        <!-- Bouton afficher/masquer mot de passe -->
                        <Button Grid.Column="1"
                                Name="btnTogglePassword"
                                Content="👁️"
                                Click="BtnTogglePassword_Click"
                                Background="Transparent"
                                Foreground="#666"
                                FontSize="16"
                                Padding="10,0"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Afficher le mot de passe"/>
                    </Grid>

                    <!-- TextBox masqué pour afficher le mot de passe en clair -->
                    <TextBox Name="txtPasswordVisible" 
                             Style="{StaticResource ErrorTextBoxStyle}"
                             Margin="0,0,0,15"
                             Visibility="Collapsed"/>
                    
                    <!-- Conteneur pour message d'erreur avec meilleur espacement -->
                    <Border Name="borderError"
                            Background="#FFEBEE"
                            BorderBrush="#D32F2F"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,0,0,15"
                            Visibility="Collapsed">
                        <TextBlock Name="txtError" 
                                   Text="" 
                                   Foreground="#B71C1C"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Name="btnLogin" 
                                Content="Se connecter" 
                                Click="BtnLogin_Click"
                                Background="#8B3A3A"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Padding="40,12"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0"/>
                        <Button Name="btnCancel" 
                                Content="Annuler" 
                                Click="BtnCancel_Click"
                                Background="#E8EAED"
                                Foreground="#2C3E50"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Padding="40,12"
                                BorderThickness="1"
                                BorderBrush="#D8D8D8"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
