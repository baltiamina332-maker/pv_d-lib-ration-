                                    <!-- Statut et Boutons de Génération -->
                                    <TextBlock Name="txtStatutGeneration" Foreground="#DC2626" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="📄 Générer PV Word (.docx)" Click="BtnGenererPVWord_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                                        <Button Content="📊 Générer PV Excel (.xlsx)" Click="BtnExporterExcel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                        <Button Name="btnMailingPV" Content="📧 Envoyer PV par Email" Click="BtnOpenMailing_Click" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==========================================
                         ONGLET 3 : HISTORIQUE & ARCHIVES (COMPLET AVEC BOUTONS ACTIONS ROW)
                         ========================================== -->
                    <TabItem Header="Historique">
                        <Border Background="White" CornerRadius="16" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📂 Historique des Délibérations Générées" Style="{StaticResource Title}"/>
                                        <TextBlock Text="Retrouvez l'ensemble des procès-verbaux générés, ouvrez les fichiers et gérez vos archives" Style="{StaticResource BodyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="🔄 Rafraîchir" Click="RefreshHistorique" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                        <Button Content="🧪 Test Historique" Click="BtnTestHistorique_Click" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Recherche Historique -->
                                <Grid Grid.Row="1" Margin="0,0,0,14">
                                    <TextBox Name="txtRechercheHistorique" Style="{StaticResource RedInputTextBoxStyle}" Width="380" HorizontalAlignment="Left"/>
                                </Grid>

                                <!-- DataGrid Historique Complet -->
                                <DataGrid Name="dgHistorique" Grid.Row="2" AutoGenerateColumns="False"
                                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                          RowHeight="38" FontSize="13">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateDeliberation, StringFormat='dd/MM/yyyy HH:mm'}" SortMemberPath="DateDeliberation" Width="150"/>
                                        <DataGridTextColumn Header="Classe/Groupe" Binding="{Binding Classe}" SortMemberPath="Classe" Width="140"/>
                                        <DataGridTextColumn Header="Session" Binding="{Binding Session}" SortMemberPath="Session" Width="100"/>
                                        <DataGridTextColumn Header="Étudiants" Binding="{Binding NbEtudiants}" SortMemberPath="NbEtudiants" Width="80"/>
                                        <DataGridTextColumn Header="Admis" Binding="{Binding NbAdmis}" SortMemberPath="NbAdmis" Width="70"/>
                                        <DataGridTextColumn Header="Ajournés" Binding="{Binding NbAjournes}" SortMemberPath="NbAjournes" Width="80"/>
                                        <DataGridTextColumn Header="Fichier" Binding="{Binding NomFichier}" SortMemberPath="NomFichier" Width="*"/>
                                        <DataGridTemplateColumn Header="Actions" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="📄 Fichier" Padding="6,3" Style="{StaticResource PrimaryButton}" FontSize="11" Margin="0,0,4,0" Click="BtnOpenHistoriqueFile_Click"/>
                                                        <Button Content="📂 Dossier" Padding="6,3" Style="{StaticResource SecondaryButton}" FontSize="11" Margin="0,0,4,0" Click="BtnOpenHistoriqueFolder_Click"/>
                                                        <Button Content="🗑️" Padding="6,3" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnDeleteHistorique_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ==========================================
                         ONGLET 4 : DASHBOARD IA & MACHINE LEARNING (3 MODÈLES ML)
                         ========================================== -->
                    <TabItem Name="tabItemDashboardIA" Header="DashboardIA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                
                                <!-- En-tête Dashboard IA -->
                                <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🤖 Assistant IA &amp; Prédictions ML" Style="{StaticResource Title}"/>
                                            <TextBlock Text="Analyse prédictive avec 3 modèles de Machine Learning : Arbre de Décision, KNN et Random Forest" Style="{StaticResource BodyText}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Name="btnChargerFichierML" Content="📂 Charger Fichier Excel" Click="BtnChargerFichierML_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                            <Button Name="btnExecuterAnalyseML" Content="🚀 Exécuter Analyse ML" Click="BtnExecuterAnalyseML_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                            <Button Name="btnRetourDashboard" Content="◀ Retour" Click="BtnRetourDashboard_Click" Style="{StaticResource SecondaryButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Statut du fichier chargé -->
                                <Border Name="borderStatutFichierML" Background="#FEF2F2" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📊" FontSize="18" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Name="txtNomFichierML" Text="Fichier: exemple.xlsx" FontWeight="Bold" Foreground="#DC2626"/>
                                            <TextBlock Name="txtInfoFichierML" Text="0 étudiants chargés" FontSize="12" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Button Name="btnSupprimerFichierML" Grid.Column="2" Content="✕" Click="BtnSupprimerFichierML_Click" Background="Transparent" Foreground="#DC2626" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    </Grid>
                                </Border>

                                <!-- 3 CARTES MODÈLES ML -->
                                <UniformGrid Columns="3" Margin="0,0,0,20">
                                    <!-- MODÈLE 1: ARBRE DE DÉCISION -->
                                    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,8,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Border Grid.Row="0" Background="#FEF2F2" CornerRadius="50" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="🌳" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="Arbre de Décision" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#DC2626"/>
                                                <TextBlock Name="txtPrecisionArbre" Text="Précision: 92.3%" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="Prédictions:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Name="txtArbreAdmis" Text="0 Admis" FontSize="10" Foreground="#059669"/>
                                                        <TextBlock Name="txtArbreAjournes" Text="0 Ajournés" FontSize="10" Foreground="#D97706"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Name="txtArbreRattrapage" Text="0 Rattrapage" FontSize="10" Foreground="#0369A1"/>
                                                        <TextBlock Name="txtArbreExclus" Text="0 Exclus" FontSize="10" Foreground="#DC2626"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- MODÈLE 2: KNN -->
                                    <Border Background="White" CornerRadius="16" Padding="20" Margin="4,0,4,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Border Grid.Row="0" Background="#FEE2E2" CornerRadius="50" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="🔗" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="K-Nearest Neighbors" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#B91C1C"/>
                                                <TextBlock Name="txtPrecisionKNN" Text="Précision: 89.7%" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="Prédictions:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Name="txtKNNAdmis" Text="0 Admis" FontSize="10" Foreground="#059669"/>
                                                        <TextBlock Name="txtKNNAjournes" Text="0 Ajournés" FontSize="10" Foreground="#D97706"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Name="txtKNNRattrapage" Text="0 Rattrapage" FontSize="10" Foreground="#0369A1"/>
                                                        <TextBlock Name="txtKNNExclus" Text="0 Exclus" FontSize="10" Foreground="#DC2626"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- MODÈLE 3: RANDOM FOREST -->
                                    <Border Background="White" CornerRadius="16" Padding="20" Margin="8,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Border Grid.Row="0" Background="#FFF1F2" CornerRadius="50" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="🌲" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="Random Forest" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#EF4444"/>
                                                <TextBlock Name="txtPrecisionRF" Text="Précision: 94.2%" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="Prédictions:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Name="txtRFAdmis" Text="0 Admis" FontSize="10" Foreground="#059669"/>
                                                        <TextBlock Name="txtRFAjournes" Text="0 Ajournés" FontSize="10" Foreground="#D97706"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Name="txtRFRattrapage" Text="0 Rattrapage" FontSize="10" Foreground="#0369A1"/>
                                                        <TextBlock Name="txtRFExclus" Text="0 Exclus" FontSize="10" Foreground="#DC2626"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <!-- CONSENSUS IA & RÉSULTATS -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- DataGrid Résultats ML -->
                                    <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                                <TextBlock Text="🧠 Résultats des 3 Modèles ML" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="📊 Exporter Résultats" Click="BtnExporterResultatsML_Click" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <DataGrid Name="dgResultatsML" Grid.Row="1" AutoGenerateColumns="False" 
                                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                                      RowHeight="32" FontSize="11" MaxHeight="400">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Étudiant" Binding="{Binding NomPrenom}" Width="140">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Moy." Binding="{Binding MoyenneGenerale, StringFormat='{}{0:F1}'}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="🌳 Arbre" Binding="{Binding ArbreDecision}" Width="70">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="🔗 KNN" Binding="{Binding Knn}" Width="70">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="🌲 Random Forest" Binding="{Binding RandomForest}" Width="90">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="🧠 Consensus IA" Binding="{Binding ConsensusLabel}" Width="90">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Confiance" Binding="{Binding Confiance}" Width="70">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- Consensus IA & Actions -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        
                                        <!-- Carte Consensus -->
                                        <Border Background="White" CornerRadius="16" Padding="18" Margin="0,0,0,16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Border Background="#991B1B" CornerRadius="50" Width="50" Height="50" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <TextBlock Text="🧠" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Consensus IA" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#991B1B" Margin="0,0,0,8"/>
                                                
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="Admis" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Name="txtConsensusAdmis" Text="0" FontSize="11" HorizontalAlignment="Right" Foreground="#059669" FontWeight="Bold"/>
                                                    </Grid>
                                                    <Grid>
                                                        <TextBlock Text="Ajournés" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Name="txtConsensusAjournes" Text="0" FontSize="11" HorizontalAlignment="Right" Foreground="#D97706" FontWeight="Bold"/>
                                                    </Grid>
                                                    <Grid>
                                                        <TextBlock Text="Exclus" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Name="txtConsensusExclus" Text="0" FontSize="11" HorizontalAlignment="Right" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Actions ML -->
                                        <Border Background="White" CornerRadius="16" Padding="18">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="Actions ML" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,12"/>
                                                <Button Name="btnGenererRapportML" Content="📋 Rapport ML" Click="BtnGenererRapportML_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
                                                <Button Name="btnComparerModeles" Content="⚖️ Comparer Modèles" Click="BtnComparerModeles_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                                                <Button Name="btnVoirDetailsIA" Content="🔍 Détails IA" Click="BtnVoirDetailsIA_Click" Style="{StaticResource SecondaryButton}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==========================================
                         ONGLET 5 : ADMINISTRATION & USERS (COMPLET AVEC EDIT ET DELETE)
                         ========================================== -->
                    <TabItem Name="tabItemAdministration" Header="Administration">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="White" CornerRadius="16" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="👑 Administration des Utilisateurs" Style="{StaticResource Title}"/>
                                    <TextBlock Text="Gérez les comptes enseignants et administrateurs du système" Style="{StaticResource BodyText}" Margin="0,0,0,20"/>

                                    <!-- Formulaire Ajout Utilisateur -->
                                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Nom d'utilisateur" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBox Name="txtNewUsername" Style="{StaticResource RedInputTextBoxStyle}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                                <TextBlock Text="Nom Complet" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBox Name="txtNewFullName" Style="{StaticResource RedInputTextBoxStyle}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                                <TextBlock Text="Mot de Passe" FontSize="11.5" FontWeight="SemiBold"/>
                                                <PasswordBox Name="txtNewPassword" Background="White" BorderBrush="#DC2626" BorderThickness="1.5" Padding="12,8" FontSize="13" Foreground="#0F172A" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Margin="6,0,6,0">
                                                <TextBlock Text="Rôle" FontSize="11.5" FontWeight="SemiBold"/>
                                                <ComboBox Name="cmbRole" Style="{StaticResource RedInputComboBoxStyle}">
                                                    <ComboBoxItem Content="Enseignant" IsSelected="True"/>
                                                    <ComboBoxItem Content="Admin"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <Button Name="btnAddUser" Grid.Column="4" Content="➕ Ajouter" Click="BtnAddUser_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>

                                    <!-- DataGrid Utilisateurs Complet -->
                                    <DataGrid Name="dgUsers" AutoGenerateColumns="False" Background="White" BorderBrush="#E2E8F0" RowHeight="36" FontSize="13">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="140"/>
                                            <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" Width="190"/>
                                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="190"/>
                                            <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="110"/>
                                            <DataGridTextColumn Header="Statut" Binding="{Binding IsActive}" Width="90"/>
                                            <DataGridTemplateColumn Header="Actions" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Modifier" Padding="6,3" Style="{StaticResource PrimaryButton}" FontSize="11" Margin="0,0,4,0" Click="BtnModifyUser_Click"/>
                                                            <Button Content="Supprimer" Padding="6,3" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnDeleteUser_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Section Mailing -->
                                    <Border Style="{StaticResource ModernCard}" Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📧 Mailing - Envoyer PV aux Enseignants" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                            <TextBlock Text="Envoyez des fichiers PV à plusieurs enseignants par email" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>
                                            <Button Name="btnOpenMailing" Content="📧 Ouvrir Mailing" Click="BtnOpenMailing_Click" Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==========================================
                         ONGLET 6 : PARAMÈTRES & RÈGLES CDC (COMPLET AVEC SEUILS ET DOSSIERS)
                         ========================================== -->
                    <TabItem Name="tabParametres" Header="Parametres">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="White" CornerRadius="16" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="⚙️ Paramètres du Système &amp; Règles de Décision" Style="{StaticResource Title}"/>
                                    <TextBlock Text="Configuration des seuils de délibération, des mentions et des chemins d'archivage" Style="{StaticResource BodyText}" Margin="0,0,0,20"/>

                                    <!-- Formulaire Configuration des Seuils de Décision -->
                                    <GroupBox Header="⚖️ Configuration des Seuils de Décision (Règles CDC)" Padding="16" Margin="0,0,0,20" BorderBrush="#E2E8F0">
                                        <StackPanel>
                                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                                <StackPanel Margin="0,0,8,8">
                                                    <TextBlock Text="Seuil Admission (Moyenne/20)" FontWeight="SemiBold"/>
                                                    <TextBox Name="txtSeuilAdmission" Text="10.0" Style="{StaticResource RedInputTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Margin="4,0,4,8">
                                                    <TextBlock Text="Seuil Très Bien (>=)" FontWeight="SemiBold"/>
                                                    <TextBox Name="txtSeuilTB" Text="16.0" Style="{StaticResource RedInputTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Margin="8,0,0,8">
                                                    <TextBlock Text="Seuil Bien (>=)" FontWeight="SemiBold"/>
                                                    <TextBox Name="txtSeuilB" Text="14.0" Style="{StaticResource RedInputTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="Seuil Assez Bien (>=)" FontWeight="SemiBold"/>
                                                    <TextBox Name="txtSeuilAB" Text="12.0" Style="{StaticResource RedInputTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Margin="4,0,4,0">
                                                    <TextBlock Text="Seuil Passable (>=)" FontWeight="SemiBold"/>
                                                    <TextBox Name="txtSeuilP" Text="10.0" Style="{StaticResource RedInputTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Margin="8,0,0,0">
                                                    <TextBlock Text="Seuil Rattrapage (>=)" FontWeight="SemiBold"/>
                                                    <TextBox Name="txtSeuilRattrapage" Text="8.0" Style="{StaticResource RedInputTextBoxStyle}"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <Button Content="💾 Enregistrer les Règles" Click="BtnSaveRules_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- Chemins & Dossiers -->
                                    <GroupBox Header="📁 Dossier de Stockage des Procès-Verbaux" Padding="16" BorderBrush="#E2E8F0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="txtDossierPV" Text="C:\Users\Documents\PV_Générés" FontSize="13" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="📂 Ouvrir Dossier" Click="BtnOpenHistoriqueFolder_Click" Style="{StaticResource SecondaryButton}"/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- TabItem Affectations - Visible pour Admin ET Enseignants -->
                    <TabItem Name="tabItemAffectations" Header="Affectations">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="White" CornerRadius="16" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- En-tête pour Affectations -->
                                    <TextBlock Grid.Row="0" Text="📋 Registre des Affectations Enseignant-Classe-Matière" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="Gestion des affectations des enseignants à leurs classes et matières" FontSize="13" Foreground="#718096" Margin="0,0,0,16"/>

                                    <!-- Tableau des Affectations -->
                                    <DataGrid Grid.Row="2" Name="dgAffectations" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,16">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Enseignant" Binding="{Binding Enseignant}" Width="150"/>
                                            <DataGridTextColumn Header="Classe" Binding="{Binding NomClasse}" Width="150"/>
                                            <DataGridTextColumn Header="Matière" Binding="{Binding Matiere}" Width="150"/>
                                            <DataGridTextColumn Header="Niveau" Binding="{Binding Niveau}" Width="100"/>
                                            <DataGridTextColumn Header="Filière" Binding="{Binding Filiere}" Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Barre de statut -->
                                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Name="txtAffectationsStatus" Text="Affectations chargées" FontSize="11" Foreground="#718096"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Name="tabAdmin" Header="AdminCache" Visibility="Collapsed"/>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ==========================================
             PANNEAU DRAWER OVERLAY ASSISTANT IA (CHATBOT SLIDING OVERLAY)
             ========================================== -->
        <Grid Name="gridAiDrawerOverlay" Visibility="Collapsed" Panel.ZIndex="1000" Grid.ColumnSpan="2">
            <Border Background="#80000000" MouseDown="GridAiDrawerOverlay_MouseDown"/>
            
            <Border HorizontalAlignment="Right" Width="440" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#DC2626" Padding="16,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="White" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                                    <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Assistant IA Délibération" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Posez vos questions ou donnez vos consignes" Foreground="#FEE2E2" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="✕" Click="BtnCloseAiDrawer_Click" HorizontalAlignment="Right" 
                                    Background="Transparent" Foreground="White" FontSize="16" FontWeight="Bold" 
                                    BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#FAFAFA" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🏆 Mentions Bien ?" Click="BtnQuickQuestion_Click" Tag="Combien d'étudiants ont eu une mention Bien ce semestre ?" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                <Button Content="📈 Taux de réussite ?" Click="BtnQuickQuestion_Click" Tag="Quel est le taux de réussite ?" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                <Button Content="📄 PV classe 3A40" Click="BtnQuickQuestion_Click" Tag="Génère-moi le PV de la classe 3A40" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                <Button Content="📊 Exporter Excel" Click="BtnQuickQuestion_Click" Tag="Exporte les admis en Excel" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer Name="scrollAiChat" Grid.Row="2" Padding="14" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="panelAiMessages"/>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="White" Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtAiInput" Padding="10" FontSize="13"
                                     Style="{StaticResource RedInputTextBoxStyle}"
                                     TextWrapping="Wrap" MaxHeight="80"
                                     KeyDown="TxtAiInput_KeyDown"/>
                            <Button Grid.Column="1" Content="Envoyer ➔" Click="BtnSendAiMessage_Click" 
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Contrôles Masqués pour compatibilité Code-Behind (Wizard & Gabarit Cache) -->
        <Grid Visibility="Collapsed">
            <Grid Name="gridWizardStep1"/>
            <Grid Name="gridWizardStep2"/>
            <Grid Name="gridWizardStep3"/>
            <Grid Name="gridWizardStep4"/>

            <Button Name="btnWizardStep1Nav"/>
            <Button Name="btnWizardStep2Nav"/>
            <Button Name="btnWizardStep3Nav"/>
            <Button Name="btnWizardStep4Nav"/>

            <TextBlock Name="txtWizardStep1FileTitle"/>
            <TextBlock Name="txtWizardStep1FileDesc"/>
            <Button Name="btnWizardGoStep2"/>

            <Border Name="borderGabaritValidation">
                <StackPanel>
                    <TextBlock Name="txtGabaritValidationTitle"/>
                    <TextBlock Name="txtGabaritValidationDesc"/>
                </StackPanel>
            </Border>

            <TextBlock Name="txtWizardStep2TotalCount"/>
            <TextBlock Name="txtWizardStep2AdmisCount"/>
            <TextBlock Name="txtWizardStep2AjourneCount"/>
            <TextBlock Name="txtWizardStep2MoyenneGenerale"/>
            <DataGrid Name="dgWizardPreview"/>

            <TextBlock Name="txtWizardStep4Classe"/>
            <TextBlock Name="txtWizardStep4Effectif"/>
            <TextBlock Name="txtWizardStep4Jury"/>
            <TextBlock Name="txtWizardStep4Date"/>
        </Grid>
    </Grid>
</Window>
