<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Système de Génération des PV de Délibération" 
        Height="860" Width="1420"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- ========================= DESIGN SYSTEM ROUGE VIBRANT ========================= -->
        <!-- Style du Panneau Sidebar -->
        <Style x:Key="SidebarStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style des Boutons de Menu Inactifs -->
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style du Bouton de Menu Actif (Thème Rouge avec Pastille) -->
        <Style x:Key="ActiveMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" 
                                                  HorizontalAlignment="Left" 
                                                  VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#DC2626" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input Style Rouge -->
        <Style x:Key="RedInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#991B1B"/>
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style Rouge -->
        <Style x:Key="RedInputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <!-- DataGrid En-tête Rouge -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#EF4444" BorderThickness="0,0,1,1">
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SortArrow" Grid.Column="1" Text="" FontSize="11" Foreground="#FDE047" Margin="4,0,2,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value=" ▲"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Text" Value=" ▼"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ========================= DISPOSITION PRINCIPALE (SIDEBAR + CONTENU) ========================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Panneau Gauche -->
            <ColumnDefinition Width="270"/>
            <!-- Zone de Travail Droite -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==========================================
             SIDEBAR ELEGANTE ( STYLE MAQUETTE ROUGE )
             ========================================== -->
        <Border Name="borderSidebar" Grid.Column="0" Style="{StaticResource SidebarStyle}">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <!-- Profil Utilisateur & Metriques -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <!-- Menu Navigation Navigation -->
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SECTION 1 : PROFIL ET STATISTIQUES (3 KPIS AVATAR) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Border Width="68" Height="68" CornerRadius="34" 
                            Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="3" 
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="👤" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Name="txtUserInfo" Text="Sarah Brown" 
                               FontSize="16" FontWeight="Bold" Foreground="#0F172A" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Name="txtUserRole" Text="Administrateur" 
                               FontSize="12" Foreground="#64748B" 
                               HorizontalAlignment="Center" Margin="0,2,0,14"/>

                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Name="txtSidebarEtudiants" Text="0" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            <TextBlock Text="Étudiants" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Name="txtSidebarPVs" Text="0" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            <TextBlock Text="PVs" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Name="txtSidebarNotifs" Text="7" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            <TextBlock Text="Notifs" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <!-- Ligne de séparation -->
                <Border Grid.Row="1" Background="#F1F5F9" Margin="0,0,0,16"/>

                <!-- SECTION 2 : MENU DE NAVIGATION SIDEBAR -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MENU PRINCIPAL" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,8"/>

                        <Button Name="btnNavDashboard" Content="🏠 Home / Dashboard" 
                                Style="{StaticResource ActiveMenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="0"/>

                        <Button Name="btnNavEtudiants" Content="📥 Import &amp; Vue Étudiants" 
                                Style="{StaticResource MenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="1"/>

                        <Button Name="btnNavPV" Content="📋 Génération PV" 
                                Style="{StaticResource MenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="2"/>

                        <Button Name="btnNavHistorique" Content="📂 Historique &amp; Archives" 
                                Style="{StaticResource MenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="3"/>

                        <Button Name="btnNavIA" Content="🤖 Dashboard IA &amp; ML" 
                                Style="{StaticResource MenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="4"/>

                        <Border Name="borderConfigurationSeparator" Height="1" Background="#F1F5F9" Margin="8,14,8,14"/>

                        <TextBlock Name="txtConfigurationHeader" Text="CONFIGURATION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,8"/>

                        <Button Name="btnNavAdmin" Content="👑 Administration" 
                                Style="{StaticResource MenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="5"/>

                        <Button Name="btnNavParametres" Content="⚙️ Paramètres &amp; Règles" 
                                Style="{StaticResource MenuItemStyle}" 
                                Click="BtnNavTab_Click" Tag="6"/>

                        <!-- Switch Mode Clair/Sombre Interactif -->
                        <Border Name="btnToggleTheme" MouseLeftButtonDown="BtnToggleTheme_Click" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,10,0,0" Cursor="Hand" ToolTip="Basculer entre Mode Clair et Mode Sombre">
                            <Grid Name="gridThemeContainer">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Name="txtThemeMode" Text="☀️ Mode Clair" FontSize="12" Foreground="#475569" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Name="borderToggleSwitch" HorizontalAlignment="Right" Width="38" Height="20" CornerRadius="10" Background="#DC2626">
                                    <Ellipse Name="ellipseToggleKnob" Width="14" Height="14" Fill="White" HorizontalAlignment="Right" Margin="3,0"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SECTION 3 : FOOTER SIDEBAR (DÉCONNEXION) -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button Name="btnLogout" Content="🚪 Déconnexion" 
                            Style="{StaticResource MenuItemStyle}" 
                            Foreground="#DC2626" FontWeight="SemiBold"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==========================================
             ZONE PRINCIPALE & EN-TÊTE ROUGE VIBRANT
             ========================================== -->
        <Grid Grid.Column="1" Margin="0,16,16,16">
            <Grid.RowDefinitions>
                <!-- En-tête Gradient Rouge Supérieur -->
                <RowDefinition Height="Auto"/>
                <!-- Contenu des Onglets -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR: BANNIÈRE GRADIENT ROUGE -->
            <Border Grid.Row="0" CornerRadius="18" Padding="20,12" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#991B1B" Offset="0.0"/>
                        <GradientStop Color="#DC2626" Offset="0.45"/>
                        <GradientStop Color="#EF4444" Offset="0.80"/>
                        <GradientStop Color="#F87171" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#DC2626" BlurRadius="15" ShadowDepth="3" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎓" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PV Generator" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Système de Délibération Universitaire" FontSize="11" Foreground="#FEE2E2"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Barre de Recherche Glassmorphique -->
                    <Border Grid.Column="1" Background="#35FFFFFF" CornerRadius="22" Padding="12,4" Margin="24,0" Width="420" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="6,0,8,0"/>
                            <TextBox Name="txtQuickAiPrompt" Grid.Column="1" 
                                     Text="Tapez pour rechercher un étudiant, PV, classe..." 
                                     Foreground="White" Background="Transparent" BorderThickness="0" 
                                     FontSize="12.5" VerticalAlignment="Center"
                                     GotFocus="TxtQuickAiPrompt_GotFocus" LostFocus="TxtQuickAiPrompt_LostFocus"
                                     KeyDown="TxtQuickAiPrompt_KeyDown"/>
                            <Button Grid.Column="2" Content="➔" Click="BtnQuickAiSend_Click" 
                                    Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                                    Cursor="Hand" Padding="6,2" ToolTip="Rechercher / Poser à l'IA"/>
                        </Grid>
                    </Border>

                    <!-- Boutons d'Action Rapide & Notifications -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="btnOpenMessages" Click="BtnOpenMessages_Click" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Consulter les messages">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#30FFFFFF">
                                <TextBlock Text="✉️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <Grid Margin="0,0,14,0" ToolTip="Notifications">
                            <Button Name="btnOpenNotifications" Click="BtnOpenNotifications_Click" Width="36" Height="36" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#30FFFFFF">
                                    <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Border Width="18" Height="18" CornerRadius="9" Background="#FDE047" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                <TextBlock Name="txtNotificationBadge" Text="7" FontSize="10" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Button Name="btnToggleAiDrawer" Content="🤖 Assistant IA" Click="BtnToggleAiDrawer_Click"
                                Foreground="#991B1B" Background="White" FontSize="12" FontWeight="Bold"
                                Padding="14,7" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 CONTENU INTEGRAL DES ONGLETS (TOUTES LES FONCTIONNALITÉS EXPLICITES)
                 ========================================== -->
            <Grid Grid.Row="1">
                <TabControl Name="tabMain" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ==========================================
                         ONGLET 0 : TABLEAU DE BORD (LIGHT ANALYTICS DASHBOARD)
                         ========================================== -->
                    <TabItem Header="Dashboard" IsSelected="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="2,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 1. EN-TÊTE DASHBOARD CLAIR -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📊 Vue d'Ensemble &amp; Analytics" Style="{StaticResource Title}" Margin="0,0,10,0"/>
                                            <Border Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="● Live Session 2026" FontSize="11" Foreground="#DC2626" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Suivi des performances des étudiants, moyennes de promotions et statistiques des PVs" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="🔄 Actualiser Données" Click="RefreshHistorique" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 2. RANGÉE DES 4 CARTES KPIS BLANCHES AVEC SPARKELINES ROUGES -->
                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                                    <!-- CARTE 1: TOTAL ÉTUDIANTS -->
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,8,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Border Width="42" Height="42" CornerRadius="12" Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1.5" HorizontalAlignment="Left">
                                                    <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="#DCFCE7" CornerRadius="12" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="↗ 12.4%" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Total étudiants" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                                            <TextBlock Name="txtTotalEtudiants" Text="3,750" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,8"/>
                                            <!-- Mini Sparkline Red -->
                                            <Viewbox Height="28" Stretch="Fill">
                                                <Path Data="M 0,22 C 20,25 35,18 55,20 C 75,22 90,10 110,14 C 130,18 150,5 170,10 C 190,14 210,4 230,8" 
                                                      Stroke="#DC2626" StrokeThickness="3"/>
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARTE 2: TAUX D'ADMISSION -->
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="4,0,4,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Border Width="42" Height="42" CornerRadius="12" Background="#FEE2E2" BorderBrush="#B91C1C" BorderThickness="1.5" HorizontalAlignment="Left">
                                                    <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="#DCFCE7" CornerRadius="12" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="↗ 8.1%" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Taux d'admission" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                                            <TextBlock Name="txtTauxAdmissionKPI" Text="88.5%" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,8"/>
                                            <TextBlock Name="txtTauxReussite" Text="88.5%" Visibility="Collapsed"/>
                                            <!-- Mini Sparkline Crimson -->
                                            <Viewbox Height="28" Stretch="Fill">
                                                <Path Data="M 0,24 C 25,22 45,26 70,18 C 95,10 115,16 140,12 C 165,8 195,14 230,5" 
                                                      Stroke="#B91C1C" StrokeThickness="3"/>
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARTE 3: MOYENNE GÉNÉRALE -->
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="4,0,4,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Border Width="42" Height="42" CornerRadius="12" Background="#FFF1F2" BorderBrush="#EF4444" BorderThickness="1.5" HorizontalAlignment="Left">
                                                    <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="#DCFCE7" CornerRadius="12" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="↗ 0.6%" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Moyenne générale" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                                            <TextBlock Name="txtMoyenneGenerale" Text="13.42 / 20" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,8"/>
                                            <TextBlock Name="txtMoyenneKPI" Text="★ 13.42/20" Visibility="Collapsed"/>
                                            <!-- Mini Sparkline Emerald -->
                                            <Viewbox Height="28" Stretch="Fill">
                                                <Path Data="M 0,25 C 20,28 50,22 75,18 C 100,14 125,20 150,12 C 175,6 200,10 230,4" 
                                                      Stroke="#10B981" StrokeThickness="3"/>
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARTE 4: PVs GÉNÉRÉS -->
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="8,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Border Width="42" Height="42" CornerRadius="12" Background="#FFE4E6" BorderBrush="#991B1B" BorderThickness="1.5" HorizontalAlignment="Left">
                                                    <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="#FEE2E2" CornerRadius="12" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="↘ 2.1%" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Procès-verbaux générés" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                                            <TextBlock Name="txtTotalPV" Text="64" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,8"/>
                                            <TextBlock Name="txtMoisPV" Text="64" Visibility="Collapsed"/>
                                            <TextBlock Name="txtJourPV" Text="12" Visibility="Collapsed"/>
                                            <!-- Mini Sparkline Amber -->
                                            <Viewbox Height="28" Stretch="Fill">
                                                <Path Data="M 0,8 C 30,12 50,6 80,14 C 110,22 140,16 170,24 C 190,20 210,26 230,22" 
                                                      Stroke="#F59E0B" StrokeThickness="3"/>
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- 3. RANGÉE PRINCIPALE: GRAPHIQUE PROGRESSION + DONUT DÉCISIONS -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PANNEAU GAUCHE: GRAPHIQUE PROGRESSION SPLINE ROUGE -->
                                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,12,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- Top Bar Panel Graphique -->
                                            <Grid Margin="0,0,0,16">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Aperçu des Délibérations &amp; Moyennes" FontSize="13" Foreground="#64748B" FontWeight="Medium"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                        <TextBlock Name="txtBigAverageHeader" Text="13.42 / 20" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                                                        <Border Background="#DCFCE7" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="↗ +18.2% vs session précédente" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Segmented Control Filtres Rouge -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F1F5F9" CornerRadius="10" Padding="4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#DC2626" CornerRadius="7" Padding="12,6" Cursor="Hand">
                                                            <TextBlock Text="Moyennes" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <Border Background="Transparent" CornerRadius="7" Padding="12,6" Cursor="Hand" Margin="2,0,0,0">
                                                            <TextBlock Text="Admis" FontSize="11.5" FontWeight="Medium" Foreground="#64748B"/>
                                                        </Border>
                                                        <Border Background="Transparent" CornerRadius="7" Padding="12,6" Cursor="Hand" Margin="2,0,0,0">
                                                            <TextBlock Text="Sessions" FontSize="11.5" FontWeight="Medium" Foreground="#64748B"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- ZONE DE DESSIN DU GRAPHIQUE ROUGE -->
                                            <Border Height="240" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                                                <Grid>
                                                    <!-- Lignes de grille horizontales -->
                                                    <UniformGrid Rows="4" VerticalAlignment="Stretch">
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                                                    </UniformGrid>

                                                    <Viewbox Stretch="Fill" Margin="10,10,10,25">
                                                        <Grid Width="700" Height="220">
                                                            <!-- Surface Dégradée Rouge -->
                                                            <Path Data="M 10,180 C 60,200 110,210 160,140 C 210,70 260,170 310,135 C 360,100 410,120 460,70 C 510,20 560,90 610,35 L 610,210 L 10,210 Z">
                                                                <Path.Fill>
                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                        <GradientStop Color="#40DC2626" Offset="0.0"/>
                                                                        <GradientStop Color="#00DC2626" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>

                                                            <!-- Courbe Red principal -->
                                                            <Path Data="M 10,180 C 60,200 110,210 160,140 C 210,70 260,170 310,135 C 360,100 410,120 460,70 C 510,20 560,90 610,35" 
                                                                  Stroke="#DC2626" StrokeThickness="3.5">
                                                                <Path.Effect>
                                                                    <DropShadowEffect Color="#DC2626" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                                                </Path.Effect>
                                                            </Path>

                                                            <!-- Points Lumineux interactifs -->
                                                            <Ellipse Canvas.Left="156" Canvas.Top="136" Width="10" Height="10" Fill="White" Stroke="#DC2626" StrokeThickness="3"/>
                                                            <Ellipse Canvas.Left="306" Canvas.Top="131" Width="10" Height="10" Fill="White" Stroke="#DC2626" StrokeThickness="3"/>
                                                            <Ellipse Canvas.Left="456" Canvas.Top="66" Width="10" Height="10" Fill="White" Stroke="#DC2626" StrokeThickness="3"/>
                                                            <Ellipse Canvas.Left="606" Canvas.Top="31" Width="10" Height="10" Fill="White" Stroke="#DC2626" StrokeThickness="3"/>
                                                        </Grid>
                                                    </Viewbox>

                                                    <!-- Axe des abscisses (Mois / Sessions) -->
                                                    <UniformGrid Columns="12" VerticalAlignment="Bottom" Margin="10,0,10,2">
                                                        <TextBlock Text="Jan" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Fév" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Mar" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Avr" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Mai" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Juin" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Juil" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Aoû" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Sep" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Oct" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Nov" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Déc" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>

                                            <!-- Actions rapides sous le graphique -->
                                            <Grid Margin="0,16,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Button Content="📊 Exporter Rapport Excel" Click="BtnExporterExcel_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                                                    <Button Content="📁 Dossier des PV Générés" Click="BtnOuvrirArchive_Click" Style="{StaticResource SecondaryButton}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANNEAU DROIT: DONUT CHART RÉPARTITION DES DÉCISIONS -->
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="24" Margin="12,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="15" ShadowDepth="2" Opacity="0.04"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Répartition des Décisions" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                                            <!-- ANNEAU DONUT CHART -->
                                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                                <Viewbox Width="170" Height="170" HorizontalAlignment="Center">
                                                    <Grid Width="200" Height="200">
                                                        <!-- Segment 1: Red (Admis 65%) -->
                                                        <Path Data="M 100,10 A 90,90 0 1,1 25,145" Stroke="#DC2626" StrokeThickness="22" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                                        <!-- Segment 2: Emerald (Rattrapage 22%) -->
                                                        <Path Data="M 20,135 A 90,90 0 0,1 60,20" Stroke="#10B981" StrokeThickness="22" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                                        <!-- Segment 3: Amber (Ajourné 8%) -->
                                                        <Path Data="M 65,15 A 90,90 0 0,1 92,10" Stroke="#F59E0B" StrokeThickness="22" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                                        <!-- Segment 4: Blue (Exclu 5%) -->
                                                        <Path Data="M 94,10 A 90,90 0 0,1 100,10" Stroke="#2563EB" StrokeThickness="22" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>

                                                        <!-- Centre du Donut avec Statistique -->
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Name="txtDonutCenterPercent" Text="88.5%" FontSize="28" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Total Admis" FontSize="11" Foreground="#64748B" FontWeight="Medium" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Viewbox>
                                            </Grid>

                                            <!-- LÉGENDE DU DONUT CHART -->
                                            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Admis" FontSize="12.5" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Name="txtLegAdmis" Text="65%" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Rattrapage" FontSize="12.5" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Name="txtLegRattrapage" Text="22%" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Ajourné" FontSize="12.5" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Name="txtLegAjourne" Text="8%" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Non Admis" FontSize="12.5" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Name="txtLegExclu" Text="5%" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==========================================
                         ONGLET 1 : IMPORT EXCEL & VUE ÉTUDIANTS (SÉPARÉS EN DEUX SECTIONS DISTINCTES)
                         ========================================== -->
                    <TabItem Header="ImportExcel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                
                                <!-- ==========================================
                                     SECTION 1: IMPORTATION DE FICHIERS EXCEL (ISOLÉE)
                                     ========================================== -->
                                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- En-tête Section Import -->
                                        <Grid Grid.Row="0" Margin="0,0,0,16">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="📥 Import de Fichier Excel" Style="{StaticResource Title}"/>
                                                <TextBlock Text="Sélectionnez et chargez un fichier Excel contenant les notes des étudiants" Style="{StaticResource BodyText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="📥 Charger Excel" Click="BtnChargerExcel_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                                <Button Name="btnAffectationEnseignant" Content="👥 Affectation Enseignant" Click="BtnAffectationEnseignant_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                                <Button Name="btnChargerClasse" Content="🏫 Charger Classe" Click="BtnChargerClasse_Click" Style="{StaticResource SecondaryButton}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Saisie Chemin Fichier -->
                                        <Grid Grid.Row="1" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄 Fichier Excel:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" HorizontalAlignment="Left" Content="📂 Parcourir" Click="BtnParcourir_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                                            <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="6" Padding="8,4">
                                                <TextBlock Name="txtStatutImport" Text="Aucun fichier sélectionné" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Statut Import & Actions Rapides -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Name="txtInfoSupplementaire" Text="Format requis : .xlsx ou .xls" Foreground="#64748B" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Name="btnAideUtilisation" Content="❓ Aide Format" Click="BtnAideUtilisation_Click" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ==========================================
                                     SECTION 2: VUE & GESTION DES ÉTUDIANTS (ISOLÉE)
                                     ========================================== -->
                                <Border Background="White" CornerRadius="16" Padding="20">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- En-tête Section Vue Étudiants -->
                                        <Grid Grid.Row="0" Margin="0,0,0,16">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="👥 Vue &amp; Gestion des Étudiants" Style="{StaticResource Title}"/>
                                                <TextBlock Text="Consultez, recherchez et gérez la liste des étudiants chargés" Style="{StaticResource BodyText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Name="btnRechargerDonnees" Content="🔄 Actualiser" Click="BtnRechargerDonnees_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                                <Button Name="btnViderTableau" Content="🗑️ Vider Liste" Click="BtnViderTableau_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                                <Button Content="📊 Exporter Excel" Click="BtnExporterExcel_Click" Style="{StaticResource PrimaryButton}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Barre de Recherche & Statistiques -->
                                        <Grid Grid.Row="1" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Border Background="#F8FAFC" CornerRadius="8" Padding="2" Margin="0,0,12,0">
                                                    <TextBox Name="txtRechercheEtudiants" 
                                                             Text="🔍 Rechercher un étudiant (nom, matricule, classe...)"
                                                             Style="{StaticResource RedInputTextBoxStyle}" 
                                                             Width="340" 
                                                             GotFocus="TxtRechercheEtudiants_GotFocus" 
                                                             LostFocus="TxtRechercheEtudiants_LostFocus"
                                                             Foreground="#94A3B8"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                                <Border Background="#FEF2F2" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="👥" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Name="txtCompteurEtudiants" Text="0 Étudiants" Foreground="#DC2626" FontWeight="Bold" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Name="borderStatutDecisions" Background="#FEF2F2" CornerRadius="8" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Name="txtStatutDecisions" Text="Prêt à générer PV" Foreground="#DC2626" FontWeight="Bold" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- DataGrid Liste Étudiants Optimisée -->
                                        <DataGrid Name="dgDonnees" Grid.Row="2" AutoGenerateColumns="False" 
                                                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                                  RowHeight="38" FontSize="13" MouseDoubleClick="DgDonnees_MouseDoubleClick"
                                                  AlternatingRowBackground="#FAFBFC" CanUserSortColumns="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="N°" Binding="{Binding NumeroOrdre}" SortMemberPath="NumeroOrdre" Width="55">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Matricule / CNE" Binding="{Binding Matricule}" SortMemberPath="Matricule" Width="135">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="Consolas"/>
                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Nom &amp; Prénom" Binding="{Binding NomPrenom}" SortMemberPath="NomPrenom" Width="210">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Classe / Filière" Binding="{Binding ClasseGroupe}" SortMemberPath="ClasseGroupe" Width="140">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="Padding" Value="6,2"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Moyenne" Binding="{Binding MoyenneGenerale, StringFormat='{}{0:F2}/20'}" SortMemberPath="MoyenneGenerale" Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="FontFamily" Value="Consolas"/>
                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Décision" Binding="{Binding Decision}" SortMemberPath="Decision" Width="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Padding" Value="8,3"/>
                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" SortMemberPath="Mention" Width="140">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Observations" Binding="{Binding Observation}" SortMemberPath="Observation" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==========================================
                         ONGLET 2 : GÉNÉRATION PV (COMPLET AVEC JURY POPUPS ET DATES)
                         ========================================== -->
                    <TabItem Header="GenerationPV">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="White" CornerRadius="16" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="📋 Génération des Procès-Verbaux (PV)" Style="{StaticResource Title}"/>
                                    <TextBlock Text="Saisissez les informations de session et du jury pour éditer les PV officiels Word/Excel" Style="{StaticResource BodyText}" Margin="0,0,0,20"/>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Formulaire Établissement & Session & Date -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Nom de l'Établissement / Faculté" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Name="txtEtablissement" Style="{StaticResource RedInputTextBoxStyle}" Text="Université Virtuelle de Tunis" Margin="0,0,0,14"/>

                                            <TextBlock Text="Session de Délibération" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ComboBox Name="cmbTypeSession" Style="{StaticResource RedInputComboBoxStyle}" Margin="0,0,0,14">
                                                <ComboBoxItem Content="Session Principale 2026" IsSelected="True"/>
                                                <ComboBoxItem Content="Session de Rattrapage 2026"/>
                                            </ComboBox>

                                            <TextBlock Text="Date de Délibération" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <DatePicker Name="dpDateDeliberation" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="Aujourd'hui" Click="BtnDateSuggestion_Click" Tag="Today" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="Janvier" Click="BtnDateSuggestion_Click" Tag="Janvier" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="Juin" Click="BtnDateSuggestion_Click" Tag="Juin" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Formulaire Membres du Jury avec Popups Autocomplete -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Président du Jury" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,10">
                                                <TextBox Name="txtPresidentJury" Style="{StaticResource RedInputTextBoxStyle}" Text="Prof. Ahmed Ben Ali"/>
