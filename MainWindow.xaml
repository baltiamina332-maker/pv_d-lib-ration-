                                                <Popup Name="popSecretaire" PlacementTarget="{Binding ElementName=txtSecretaire}" StaysOpen="False">
                                                    <ListBox Name="lstSecretaire" MaxHeight="120" Width="280"/>
                                                </Popup>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Membre Jury 1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <TextBox Name="txtMembreJury1" Style="{StaticResource RedInputTextBoxStyle}" Text="Dr. Mohamed Khalil"/>
                                                        <Popup Name="popMembreJury1" PlacementTarget="{Binding ElementName=txtMembreJury1}" StaysOpen="False">
                                                            <ListBox Name="lstMembreJury1" MaxHeight="120" Width="140"/>
                                                        </Popup>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Membre Jury 2" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <TextBox Name="txtMembreJury2" Style="{StaticResource RedInputTextBoxStyle}" Text="Dr. Leila Mansour"/>
                                                        <Popup Name="popMembreJury2" PlacementTarget="{Binding ElementName=txtMembreJury2}" StaysOpen="False">
                                                            <ListBox Name="lstMembreJury2" MaxHeight="120" Width="140"/>
                                                        </Popup>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
