<Application x:Class="DesktopApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Palettes de couleurs universitaires et modernes en Thème Rouge Vibrant -->
        <!-- Couleurs principales Rouge -->
        <Color x:Key="ColorBordeaux">#DC2626</Color>
        <Color x:Key="ColorBordeauxLight">#EF4444</Color>
        <Color x:Key="ColorBordeauxDark">#991B1B</Color>
        <Color x:Key="ColorGrisLight">#F8FAFC</Color>
        <Color x:Key="ColorGrisMedium">#E2E8F0</Color>
        <Color x:Key="ColorGrisDark">#64748B</Color>
        <Color x:Key="ColorAccent">#EF4444</Color>
        
        <!-- Ressources de pinceaux (Brushes) -->
        <SolidColorBrush x:Key="BrushBordeaux" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrushBordeauxLight" Color="#EF4444"/>
        <SolidColorBrush x:Key="BrushBordeauxDark" Color="#991B1B"/>
        <SolidColorBrush x:Key="BrushGrisLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushGrisMedium" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushGrisDark" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#EF4444"/>

        <!-- Style Bouton Implicite par Défaut (Rouge Clair & Blanc) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FDA4AF"/>
                                <Setter Property="Foreground" Value="#7F1D1D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FECDD3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Bouton Principal (Bordeaux / Red Bold) -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7F1D1D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Bouton Secondaire (Rouge Clair et Blanc) -->
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FDA4AF"/>
                                <Setter Property="Foreground" Value="#7F1D1D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FECDD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Bouton Accent (Cramoisi / Red) -->
        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#8B0000"/>
        </Style>

        <!-- Style Bouton Succès / Validation (Bordeaux Rouge) -->
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#991B1B"/>
        </Style>

        <!-- Style TextBlock Titre -->
        <Style TargetType="TextBlock" x:Key="Title">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Style TextBlock Sous-titre -->
        <Style TargetType="TextBlock" x:Key="SubTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Style TextBlock Texte normal -->
        <Style TargetType="TextBlock" x:Key="BodyText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="LineHeight" Value="1.5"/>
        </Style>
    </Application.Resources>
</Application>
