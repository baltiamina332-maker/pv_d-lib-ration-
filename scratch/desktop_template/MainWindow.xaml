<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Système de Génération des PV de Délibération" 
        Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
        
    <!-- Force regeneration -->

    <Window.Resources>
        <!-- Styles texte uniformisés -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <!-- Styles boutons unifiés (Palette corporate 2 couleurs principales + déclinaisons neutres) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8B3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6B2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2B5B84"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E3E5B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#962D22"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style global pour les en-têtes DataGrid avec flèche de tri ▲/▼ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#8B3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#DEE2E6" BorderThickness="0,0,1,1">
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="SortArrow" Grid.Column="1" 
                                           Text="" FontSize="11" Foreground="#FFD700" 
                                           Margin="4,0,2,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value=" ▲"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Text" Value=" ▼"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6B2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barre de navigation supérieure -->
            <RowDefinition Height="Auto"/>
            <!-- En-tête professionnel -->
            <RowDefinition Height="Auto"/>
            <!-- Zone de travail principale -->
            <RowDefinition Height="*"/>
            <!-- Barre de statut (optionnel) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRE DE NAVIGATION SUPÉRIEURE -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo/Titre système -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎓" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PV Generator" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Espace central avec Barre d'accès rapide IA -->
                <Border Grid.Column="1" Background="#1E2B37" CornerRadius="16" Padding="10,3" Margin="20,0" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🤖" FontSize="13" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <TextBox Name="txtQuickAiPrompt" Grid.Column="1" 
                                 Text="Demandez à l'IA... (ex: Mentions Bien ?, PV 3A40)" 
                                 Foreground="#A0AEC0" Background="Transparent" BorderThickness="0" 
                                 FontSize="12" VerticalAlignment="Center"
                                 GotFocus="TxtQuickAiPrompt_GotFocus" LostFocus="TxtQuickAiPrompt_LostFocus"
                                 KeyDown="TxtQuickAiPrompt_KeyDown"/>
                        <Button Grid.Column="2" Content="➔" Click="BtnQuickAiSend_Click" 
                                Background="Transparent" Foreground="#64B5F6" FontWeight="Bold" BorderThickness="0" 
                                Cursor="Hand" Padding="6,2" ToolTip="Poser la question à l'IA"/>
                    </Grid>
                </Border>
                
                <!-- Informations utilisateur, Bouton IA et déconnexion -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnToggleAiDrawer" Content="🤖 Assistant IA" Click="BtnToggleAiDrawer_Click"
                            Background="#2B5B84" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,12,0" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2B5B84"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E3E5B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Background="#34495E" Padding="12,6" Margin="0,0,15,0">
                        <TextBlock Name="txtUserInfo" 
                                   Text="👤 admin (Admin)" 
                                   Foreground="White"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button Name="btnLogout" 
                            Content="↗ Déconnexion" 
                            Click="BtnLogout_Click"
                            Background="#E74C3C"
                            Foreground="White"
                            FontSize="11"
                            Padding="15,8"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E74C3C"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EN-TÊTE PROFESSIONNEL -->
        <Border Grid.Row="1" Background="#8B3A3A" Padding="30,20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Système de Génération des PV" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Procès-Verbaux de Délibération • École Supérieure Privée d'Ingénierie et de Technologies" 
                           FontSize="13" 
                           Foreground="#F8F9FA"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Opacity="0.95"/>
            </StackPanel>
        </Border>

        <!-- ZONE DE TRAVAIL PRINCIPALE -->
        <Grid Grid.Row="2" Background="#F8F9FA">
            <TabControl Name="tabMain" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="TabBorder" 
                                            Background="#E9ECEF" 
                                            BorderBrush="#DEE2E6" 
                                            BorderThickness="1,1,1,0" 
                                            Padding="25,15"
                                            Margin="0,0,2,0">
                                        <ContentPresenter x:Name="ContentSite" 
                                                          VerticalAlignment="Center" 
                                                          HorizontalAlignment="Center" 
                                                          ContentSource="Header" 
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8B3A3A"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="2,2,2,0"/>
                                            <Setter Property="Foreground" Value="#8B3A3A"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="TabBorder" Property="Margin" Value="0,0,2,-2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#F1F3F4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ONGLET TABLEAU DE BORD -->
                <TabItem Header="📊 Tableau de Bord" FontSize="14">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="2,0,2,2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <Grid Margin="40,30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- En-tête de bienvenue -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,35">
                                    <TextBlock Text="Tableau de Bord" 
                                               Style="{StaticResource Title}" 
                                               Foreground="#2C3E50" 
                                               FontSize="28"/>
                                    <TextBlock Text="Gérez efficacement vos procès-verbaux de délibération" 
                                               Style="{StaticResource BodyText}" 
                                               FontSize="16" 
                                               Foreground="#6C757D" 
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Statistiques rapides -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,40">
                                    <TextBlock Text="📈 Statistiques" 
                                               Style="{StaticResource SubTitle}" 
                                               FontSize="20" 
                                               Margin="0,0,0,20"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,0">
                                        <Border Background="White" 
                                                BorderBrush="#E3F2FD" 
                                                BorderThickness="2" 
                                                Padding="25" 
                                                Margin="0,0,15,0">
                                            <StackPanel>
                                                <TextBlock Text="📄 Total PV" 
                                                           FontSize="14" 
                                                           Foreground="#1976D2" 
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Name="txtTotalPV" 
                                                           Text="0" 
                                                           FontSize="48" 
                                                           FontWeight="Bold" 
                                                           Foreground="#1976D2" 
                                                           HorizontalAlignment="Center"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="White" 
                                                BorderBrush="#E8F5E8" 
                                                BorderThickness="2" 
                                                Padding="25" 
                                                Margin="0,0,15,0">
                                            <StackPanel>
                                                <TextBlock Text="📅 Ce mois" 
                                                           FontSize="14" 
                                                           Foreground="#388E3C" 
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Name="txtMoisPV" 
                                                           Text="0" 
                                                           FontSize="48" 
                                                           FontWeight="Bold" 
                                                           Foreground="#4CAF50" 
                                                           HorizontalAlignment="Center"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="White" 
                                                BorderBrush="#FFF3E0" 
                                                BorderThickness="2" 
                                                Padding="25" 
                                                Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="⏰ Aujourd'hui" 
                                                           FontSize="14" 
                                                           Foreground="#F57C00" 
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Name="txtJourPV" 
                                                           Text="0" 
                                                           FontSize="48" 
                                                           FontWeight="Bold" 
                                                           Foreground="#FF9800" 
                                                           HorizontalAlignment="Center"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Actions rapides -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="🚀 Actions Rapides" 
                                               Style="{StaticResource SubTitle}" 
                                               FontSize="20" 
                                               Margin="0,0,0,20"/>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" 
                                                Content="📥 Import Excel" 
                                                Click="BtnImportExcel_Click"
                                                Width="200"
                                                Height="50"
                                                FontSize="15"
                                                Margin="10"/>
                                        <Button Style="{StaticResource SuccessButton}" 
                                                Content="📄 Générer PV" 
                                                Click="BtnGenererPV_Click"
                                                Width="200"
                                                Height="50"
                                                FontSize="15"
                                                Margin="10"/>
                                        <Button Style="{StaticResource AccentButton}" 
                                                Content="📂 Historique" 
                                                Click="BtnHistorique_Click"
                                                Width="200"
                                                Height="50"
                                                FontSize="15"
                                                Margin="10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- ONGLET IMPORT EXCEL -->
                <TabItem Header="📥 Import Excel" FontSize="14">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="2,0,2,2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="30">
                                <!-- Titre de la page -->
                                <TextBlock Style="{StaticResource Title}" Text="Import de fichier Excel" Margin="0,0,0,20"/>

                                <!-- Section de sélection de fichier -->
                                <Border Background="#F8F9FA" 
                                        Padding="25" 
                                        Margin="0,0,0,25" 
                                        BorderBrush="#E9ECEF" 
                                        BorderThickness="1">
                                    <StackPanel>
                                        <!-- En-tête de section -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Background="#E3F2FD" 
                                                    Width="40" Height="40" 
                                                    Margin="0,0,15,0">
                                                <TextBlock Text="📁" 
                                                           FontSize="18"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Sélection du fichier Excel" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="18" 
                                                           Foreground="#2C3E50"/>
                                                <TextBlock Text="Choisissez un fichier Excel contenant les données des étudiants" 
                                                           FontSize="13" 
                                                           Foreground="#6C757D" 
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Zone de sélection de fichier -->
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" 
                                                    Background="White" 
                                                    BorderBrush="#CED4DA" 
                                                    BorderThickness="2">
                                                <TextBox Name="txtCheminFichier" 
                                                         IsReadOnly="True" 
                                                         Padding="15" 
                                                         FontSize="14"
                                                         VerticalContentAlignment="Center"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="#495057"
                                                         Text="Aucun fichier sélectionné..."/>
                                            </Border>
                                            <Button Grid.Column="1" 
                                                    Content="📂 Parcourir" 
                                                    Click="BtnParcourir_Click"
                                                    Background="#6C757D"
                                                    Foreground="White"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Padding="20,0" 
                                                    BorderThickness="0"
                                                    Height="50"
                                                    Cursor="Hand"/>
                                        </Grid>

                                        <!-- Boutons d'action -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Name="btnChargerExcel" 
                                                    Content="✅ Charger et Analyser" 
                                                    Click="BtnChargerExcel_Click"
                                                    Style="{StaticResource PrimaryButton}"
                                                    IsEnabled="False"
                                                    Height="45"
                                                    FontSize="14"
                                                    Padding="30,0"
                                                    Margin="0,0,15,0"/>
                                            <Button Name="btnExporterExcel" 
                                                    Content="💾 Exporter Excel" 
                                                    Click="BtnExporterExcel_Click"
                                                    Background="#28A745"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    IsEnabled="False"
                                                    Height="45"
                                                    FontSize="14"
                                                    Padding="30,0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,15,0"/>
                                            <Button Name="btnValidationAuto" 
                                                    Content="✅ Validation Auto" 
                                                    Click="BtnValidationAutomatique_Click"
                                                    Background="#17A2B8"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    IsEnabled="False"
                                                    Height="45"
                                                    FontSize="14"
                                                    Padding="30,0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,15,0"/>
                                            <Button Name="btnChargerClasse" 
                                                    Content="📚 Charger Classe" 
                                                    Click="BtnChargerClasse_Click"
                                                    Background="#6F42C1"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    Height="45"
                                                    FontSize="14"
                                                    Padding="30,0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Zone d'affichage des données GRAND et SPACIÉUX avec MinHeight=480 -->
                                <Border BorderBrush="#DEE2E6" 
                                        BorderThickness="1" 
                                        Background="White"
                                        MinHeight="480"
                                        Margin="0,0,0,25">
                                    <Grid Margin="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Barre d'outils contextuelle -->
                                        <Border Grid.Row="0" 
                                                Background="#F8F9FA" 
                                                BorderBrush="#E9ECEF" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="10"
                                                Margin="-15,-15,-15,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔧 Outils Rapides:" 
                                                           VerticalAlignment="Center" 
                                                           FontWeight="SemiBold" 
                                                           Margin="0,0,15,0"/>
                                                <Button Name="btnRechargerDonnees" 
                                                        Content="🔄 Actualiser" 
                                                        Click="BtnRechargerDonnees_Click"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="12,6"
                                                        FontSize="12"
                                                        Margin="0,0,10,0"/>
                                                <Button Name="btnViderTableau" 
                                                        Content="🗑️ Vider" 
                                                        Click="BtnViderTableau_Click"
                                                        Background="#DC3545"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"
                                                        Padding="12,6"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="12"
                                                        Margin="0,0,10,0"/>
                                                <Button Name="btnAideUtilisation" 
                                                        Content="❓ Aide" 
                                                        Click="BtnAideUtilisation_Click"
                                                        Background="#17A2B8"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"
                                                        Padding="12,6"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Barre de recherche en temps réel (Données Étudiants) -->
                                        <Grid Grid.Row="1" Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔍 Rechercher :" FontWeight="SemiBold" FontSize="14" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Background="White" BorderBrush="#CED4DA" BorderThickness="1" Width="360" Height="36" CornerRadius="4">
                                                    <Grid>
                                                        <TextBox Name="txtRechercheEtudiants" 
                                                                 TextChanged="TxtRechercheEtudiants_TextChanged" 
                                                                 Padding="10,6" 
                                                                 FontSize="13" 
                                                                 BorderThickness="0" 
                                                                 Background="Transparent" 
                                                                 VerticalContentAlignment="Center"/>
                                                        <TextBlock Text="Rechercher nom, matricule, classe, moyenne..." 
                                                                   IsHitTestVisible="False" 
                                                                   Foreground="#999" 
                                                                   FontSize="12" 
                                                                   Margin="10,0,0,0" 
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=txtRechercheEtudiants}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Name="txtCompteurEtudiants" 
                                                       Text="" 
                                                       HorizontalAlignment="Right" 
                                                       VerticalAlignment="Center" 
                                                       FontSize="13" 
                                                       Foreground="#6C757D" 
                                                       FontWeight="SemiBold"/>
                                        </Grid>

                                        <!-- DataGrid grand et spacieux (Hauteur fixe 420px, avec scrollbar verticale visible) -->
                                        <DataGrid Grid.Row="2" 
                                                  Name="dgDonnees" 
                                                  Visibility="Visible"
                                                  AutoGenerateColumns="False" 
                                                  CanUserSortColumns="True"
                                                  GridLinesVisibility="All"
                                                  HeadersVisibility="Column"
                                                  SelectionMode="Single"
                                                  AlternationCount="2"
                                                  AlternatingRowBackground="#F9FAFB"
                                                  MinHeight="180"
                                                  MaxHeight="460"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="False"
                                                  PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                                  MouseDoubleClick="DgDonnees_MouseDoubleClick"
                                                  RowHeight="36"
                                                  FontSize="13"
                                                  Background="White"
                                                  BorderThickness="1"
                                                  BorderBrush="#CED4DA"
                                                  IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="N°" Binding="{Binding NumeroOrdre}" SortMemberPath="NumeroOrdre" Width="50"/>
                                                <DataGridTextColumn Header="Matricule / CNE" Binding="{Binding Matricule}" SortMemberPath="Matricule" Width="130"/>
                                                <DataGridTextColumn Header="Nom &amp; Prénom" Binding="{Binding NomPrenom}" SortMemberPath="NomPrenom" Width="200"/>
                                                <DataGridTextColumn Header="Classe / Filière" Binding="{Binding ClasseGroupe}" SortMemberPath="ClasseGroupe" Width="140"/>
                                                <DataGridTextColumn Header="Moyenne Générale" Binding="{Binding MoyenneGenerale, StringFormat='{}{0:F3}'}" SortMemberPath="MoyenneGenerale" Width="145"/>
                                                <DataGridTextColumn Header="Décision" Binding="{Binding Decision}" SortMemberPath="Decision" Width="120"/>
                                                <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" SortMemberPath="Mention" Width="140"/>
                                                <DataGridTextColumn Header="Validation" Binding="{Binding Validation}" SortMemberPath="Validation" Width="100"/>
                                                <DataGridTextColumn Header="Communication / Observations" Binding="{Binding Observation}" SortMemberPath="Observation" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- Barre de statut -->
                                <Border Background="#E8F5E9" 
                                        Padding="20" 
                                        BorderBrush="#C8E6C9" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Background="#4CAF50" 
                                                    Width="20" Height="20" 
                                                    Margin="0,0,15,0">
                                                <TextBlock Text="i" 
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Name="txtStatutImport" 
                                                       Text="🔄 En attente d'un fichier Excel..." 
                                                       FontSize="14"
                                                       Foreground="#2E7D32" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Name="txtInfoSupplementaire" 
                                                       Text="" 
                                                       FontSize="12"
                                                       Foreground="#388E3C" 
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,15,0"/>
                                            <Border Name="borderStatutDecisions" 
                                                    Background="#FFF3E0" 
                                                    BorderBrush="#FFB74D" 
                                                    BorderThickness="1" 
                                                    Padding="8,4"
                                                    Visibility="Collapsed">
                                                <TextBlock Name="txtStatutDecisions" 
                                                           Text="⏳ Décisions en attente" 
                                                           FontSize="11"
                                                           Foreground="#E65100"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- ONGLET GÉNÉRATION PV -->
                <TabItem Header="📄 Génération PV" FontSize="14">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="2,0,2,2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <Grid Margin="30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource Title}" Text="Génération du Procès-Verbal"/>

                                <!-- Formulaire Infos Séance -->
                                <Border Grid.Row="1" Background="#F8F9FA" Padding="20" Margin="0,0,0,20"
                                        BorderBrush="#DEE2E6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📋 Informations de la Séance" FontWeight="SemiBold"
                                                   FontSize="16" Foreground="#2C3E50" Margin="0,0,0,15"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                <TextBlock Text="Établissement" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <TextBox Name="txtEtablissement"
                                                         Text="École Supérieure Privée d'Ingénierie et de Technologies"
                                                         Padding="10" BorderBrush="#D8D8D8" BorderThickness="1" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                                <TextBlock Text="Type de Session" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <ComboBox Name="cmbTypeSession" Padding="10" BorderBrush="#D8D8D8" BorderThickness="1">
                                                    <ComboBoxItem IsSelected="True">Principale</ComboBoxItem>
                                                    <ComboBoxItem>Rattrapage</ComboBoxItem>
                                                    <ComboBoxItem>Autre</ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Date de Délibération" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <DatePicker Name="dpDateDeliberation" Padding="10"
                                                            BorderBrush="#D8D8D8" BorderThickness="1" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="Puces :" FontSize="10" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button Content="Aujourd'hui" Click="BtnDateSuggestion_Click" Tag="Today" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0"/>
                                                    <Button Content="Session Janvier" Click="BtnDateSuggestion_Click" Tag="Janvier" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0"/>
                                                    <Button Content="Session Juin" Click="BtnDateSuggestion_Click" Tag="Juin" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Formulaire Composition Jury avec Autocomplétion -->
                                <Border Grid.Row="2" Background="#F8F9FA" Padding="20" Margin="0,0,0,20"
                                        BorderBrush="#DEE2E6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="👨‍⚖️ Composition du Jury (avec Mémorisation Intelligente)" FontWeight="SemiBold"
                                                   FontSize="16" Foreground="#2C3E50" Margin="0,0,0,15"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Président du Jury -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,15">
                                                <TextBlock Text="Président du Jury" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <TextBox Name="txtPresidentJury" Padding="10"
                                                             BorderBrush="#D8D8D8" BorderThickness="1" FontSize="13"
                                                             ToolTip="Tapez pour voir les suggestions..."
                                                             KeyUp="TxtJury_KeyUp" GotFocus="TxtJury_GotFocus" LostFocus="TxtJury_LostFocus" Tag="President"/>
                                                    <Popup Name="popPresidentJury" StaysOpen="False" PlacementTarget="{Binding ElementName=txtPresidentJury}" Placement="Bottom" Width="280">
                                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="2">
                                                            <ListBox Name="lstPresidentJury" SelectionChanged="LstJurySuggestion_SelectionChanged" BorderThickness="0" MaxHeight="140" Tag="txtPresidentJury"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Secrétaire -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                                                <TextBlock Text="Secrétaire" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <TextBox Name="txtSecretaire" Padding="10"
                                                             BorderBrush="#D8D8D8" BorderThickness="1" FontSize="13"
                                                             ToolTip="Tapez pour voir les suggestions..."
                                                             KeyUp="TxtJury_KeyUp" GotFocus="TxtJury_GotFocus" LostFocus="TxtJury_LostFocus" Tag="Secretaire"/>
                                                    <Popup Name="popSecretaire" StaysOpen="False" PlacementTarget="{Binding ElementName=txtSecretaire}" Placement="Bottom" Width="280">
                                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="2">
                                                            <ListBox Name="lstSecretaire" SelectionChanged="LstJurySuggestion_SelectionChanged" BorderThickness="0" MaxHeight="140" Tag="txtSecretaire"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Membre 1 -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                                                <TextBlock Text="Membre du Jury 1" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <TextBox Name="txtMembreJury1" Padding="10"
                                                             BorderBrush="#D8D8D8" BorderThickness="1" FontSize="13"
                                                             ToolTip="Tapez pour voir les suggestions..."
                                                             KeyUp="TxtJury_KeyUp" GotFocus="TxtJury_GotFocus" LostFocus="TxtJury_LostFocus" Tag="Membre"/>
                                                    <Popup Name="popMembreJury1" StaysOpen="False" PlacementTarget="{Binding ElementName=txtMembreJury1}" Placement="Bottom" Width="280">
                                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="2">
                                                            <ListBox Name="lstMembreJury1" SelectionChanged="LstJurySuggestion_SelectionChanged" BorderThickness="0" MaxHeight="140" Tag="txtMembreJury1"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Membre 2 -->
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="Membre du Jury 2" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <TextBox Name="txtMembreJury2" Padding="10"
                                                             BorderBrush="#D8D8D8" BorderThickness="1" FontSize="13"
                                                             ToolTip="Tapez pour voir les suggestions..."
                                                             KeyUp="TxtJury_KeyUp" GotFocus="TxtJury_GotFocus" LostFocus="TxtJury_LostFocus" Tag="Membre"/>
                                                    <Popup Name="popMembreJury2" StaysOpen="False" PlacementTarget="{Binding ElementName=txtMembreJury2}" Placement="Bottom" Width="280">
                                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="2">
                                                            <ListBox Name="lstMembreJury2" SelectionChanged="LstJurySuggestion_SelectionChanged" BorderThickness="0" MaxHeight="140" Tag="txtMembreJury2"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Bouton Générer -->
                                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10">
                                    <Button Content="📄 Générer le PV (Document Word)"
                                            Click="BtnGenererPVWord_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="40,18" FontSize="16"/>
                                    <TextBlock Name="txtStatutGeneration"
                                               Text="Importez d'abord un fichier Excel, puis remplissez les informations du jury."
                                               Margin="0,15" FontSize="13" Foreground="#666"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- ONGLET HISTORIQUE -->
                <TabItem Header="📂 Historique" FontSize="14">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="2,0,2,2">
                        <Grid Margin="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource Title}" Text="Historique des PV générés"/>

                            <!-- Barre d'actions et de recherche (Historique) -->
                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="🔄 Actualiser" 
                                            Click="RefreshHistorique"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="15,8"
                                            FontSize="12"
                                            Margin="0,0,10,0"/>
                                    <Button Content="🧪 Tester Historique" 
                                            Click="BtnTestHistorique_Click"
                                            Style="{StaticResource AccentButton}"
                                            Padding="15,8"
                                            FontSize="12"
                                            Margin="0,0,20,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="🔍 Rechercher :" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Background="White" BorderBrush="#CED4DA" BorderThickness="1" Width="300" Height="34" CornerRadius="4">
                                        <Grid>
                                            <TextBox Name="txtRechercheHistorique" 
                                                     TextChanged="TxtRechercheHistorique_TextChanged" 
                                                     Padding="8,6" 
                                                     FontSize="12" 
                                                     BorderThickness="0" 
                                                     Background="Transparent" 
                                                     VerticalContentAlignment="Center"/>
                                            <TextBlock Text="Rechercher classe, date, session, fichier..." 
                                                       IsHitTestVisible="False" 
                                                       Foreground="#999" 
                                                       FontSize="11" 
                                                       Margin="10,0,0,0" 
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtRechercheHistorique}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="2" 
                                      Name="dgHistorique" 
                                      AutoGenerateColumns="False" 
                                      CanUserSortColumns="True"
                                      IsReadOnly="True"
                                      AlternatingRowBackground="#F9F9F9"
                                      MinHeight="180"
                                      MaxHeight="460"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="False"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      RowHeight="36"
                                      FontSize="13"
                                      Background="White"
                                      BorderBrush="#D8D8D8"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateDeliberation, StringFormat='dd/MM/yyyy HH:mm'}" SortMemberPath="DateDeliberation" Width="150"/>
                                    <DataGridTextColumn Header="Classe/Groupe" Binding="{Binding Classe}" SortMemberPath="Classe" Width="150"/>
                                    <DataGridTextColumn Header="Session" Binding="{Binding Session}" SortMemberPath="Session" Width="100"/>
                                    <DataGridTextColumn Header="Étudiants" Binding="{Binding NbEtudiants}" SortMemberPath="NbEtudiants" Width="80"/>
                                    <DataGridTextColumn Header="Admis" Binding="{Binding NbAdmis}" SortMemberPath="NbAdmis" Width="70"/>
                                    <DataGridTextColumn Header="Ajournés" Binding="{Binding NbAjournes}" SortMemberPath="NbAjournes" Width="80"/>
                                    <DataGridTextColumn Header="Fichier" Binding="{Binding NomFichier}" SortMemberPath="NomFichier" Width="*"/>
                                    <DataGridTemplateColumn Header="Actions" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="📄 Ouvrir" 
                                                            Padding="8,4" 
                                                            Style="{StaticResource PrimaryButton}" 
                                                            FontSize="11" 
                                                            Margin="0,0,5,0"
                                                            Click="BtnOpenHistoriqueFile_Click"/>
                                                    <Button Content="📁 Dossier" 
                                                            Padding="8,4" 
                                                            Style="{StaticResource SecondaryButton}" 
                                                            FontSize="11"
                                                            Margin="0,0,5,0"
                                                            Click="BtnOpenHistoriqueFolder_Click"/>
                                                    <Button Content="🗑️ Supprimer" 
                                                            Padding="8,4" 
                                                            Style="{StaticResource DangerButton}" 
                                                            FontSize="11"
                                                            Click="BtnDeleteHistorique_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ONGLET PARAMÈTRES -->
                <TabItem Header="⚙️ Paramètres" Name="tabParametres" FontSize="14">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="2,0,2,2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="40,35">
                                <TextBlock Style="{StaticResource Title}" Text="Paramètres &amp; Configuration Système"/>

                                <!-- Configuration des Règles de Décision (ADMIN) -->
                                <GroupBox Header="⚖️ Configuration des Règles de Décision (Administration)" 
                                          Padding="20" 
                                          Margin="0,0,0,25" 
                                          Background="#F8F9FA" 
                                          BorderBrush="#8B3A3A" 
                                          BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Définissez les seuils de Moyenne Générale pour la délibération automatique :" 
                                                   Margin="0,0,0,15" 
                                                   Foreground="#555" FontSize="13"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,12">
                                                <TextBlock Text="Seuil Admission Directe (MG)" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                <TextBox Name="txtSeuilAdmission" Text="10.0" Padding="8" BorderBrush="#D8D8D8" BorderThickness="1"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,12">
                                                <TextBlock Text="Seuil Mention Très Bien" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                <TextBox Name="txtSeuilTB" Text="16.0" Padding="8" BorderBrush="#D8D8D8" BorderThickness="1"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Seuil Mention Bien" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                <TextBox Name="txtSeuilB" Text="14.0" Padding="8" BorderBrush="#D8D8D8" BorderThickness="1"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                                                <TextBlock Text="Seuil Mention Assez Bien" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                <TextBox Name="txtSeuilAB" Text="12.0" Padding="8" BorderBrush="#D8D8D8" BorderThickness="1"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,15,0">
                                                <TextBlock Text="Seuil Mention Passable" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                <TextBox Name="txtSeuilP" Text="10.0" Padding="8" BorderBrush="#D8D8D8" BorderThickness="1"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="Seuil Session Rattrapage" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,4"/>
                                                <TextBox Name="txtSeuilRattrapage" Text="8.0" Padding="8" BorderBrush="#D8D8D8" BorderThickness="1"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="💾 Enregistrer les Règles de Décision" 
                                                Click="BtnSaveRules_Click"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                Height="38"
                                                Padding="20,0"
                                                FontSize="13"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="📁 Chemins et Dossiers" 
                                          Padding="20" 
                                          Margin="0,0,0,25" 
                                          Background="#F0F2F5" 
                                          BorderBrush="#D8D8D8" 
                                          BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Dossier de sortie des PV générés :" 
                                                   Margin="0,0,0,8" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#2C3E50"/>
                                        <TextBox Name="txtDossierPV" 
                                                 Padding="12" 
                                                 Margin="0,0,0,12" 
                                                 BorderBrush="#D8D8D8" 
                                                 BorderThickness="1"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- ONGLET ADMINISTRATION -->
                <TabItem Header="🔐 Administration" Name="tabAdmin" FontSize="14">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="2,0,2,2">
                        <Grid Margin="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource Title}" Text="Gestion des utilisateurs"/>

                            <!-- Section d'ajout d'utilisateur -->
                            <Border Grid.Row="1" 
                                    Background="#F0F2F5" 
                                    Padding="20" 
                                    Margin="0,0,0,20" 
                                    BorderBrush="#E8EAED" 
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="➕ Ajouter un nouvel utilisateur" 
                                               FontWeight="SemiBold" 
                                               FontSize="14" 
                                               Foreground="#2C3E50" 
                                               Margin="0,0,0,15"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Nom d'utilisateur" 
                                                       FontSize="12" 
                                                       Foreground="#666" 
                                                       Margin="0,0,0,5"/>
                                            <TextBox Name="txtNewUsername" 
                                                     Padding="10" 
                                                     BorderBrush="#D8D8D8" 
                                                     BorderThickness="1"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Nom complet" 
                                                       FontSize="12" 
                                                       Foreground="#666" 
                                                       Margin="0,0,0,5"/>
                                            <TextBox Name="txtNewFullName" 
                                                     Padding="10" 
                                                     BorderBrush="#D8D8D8" 
                                                     BorderThickness="1"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="Email" 
                                                       FontSize="12" 
                                                       Foreground="#666" 
                                                       Margin="0,0,0,5"/>
                                            <TextBox Name="txtNewEmail" 
                                                     Padding="10" 
                                                     BorderBrush="#D8D8D8" 
                                                     BorderThickness="1"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                            <TextBlock Text="Rôle" 
                                                       FontSize="12" 
                                                       Foreground="#666" 
                                                       Margin="0,0,0,5"/>
                                            <ComboBox Name="cmbRole" 
                                                      Padding="10" 
                                                      BorderBrush="#D8D8D8" 
                                                      BorderThickness="1">
                                                <ComboBoxItem>Utilisateur</ComboBoxItem>
                                                <ComboBoxItem>Admin</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>

                                        <Button Grid.Column="4" 
                                                Name="btnAddUser" 
                                                Content="Ajouter" 
                                                Click="BtnAddUser_Click"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="12"
                                                Padding="20,10"
                                                VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Liste des utilisateurs -->
                            <Border Grid.Row="2" BorderBrush="#D8D8D8" BorderThickness="1">
                                <DataGrid Name="dgUsers" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          AlternatingRowBackground="#F9F9F9"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          MinHeight="180"
                                          MaxHeight="400"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="False"
                                          PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                          RowHeight="36"
                                          FontSize="13"
                                          Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="130"/>
                                        <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" Width="180"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                        <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="100"/>
                                        <DataGridTextColumn Header="Statut" Binding="{Binding IsActive}" Width="80"/>
                                        <DataGridTemplateColumn Header="Actions" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Modifier" 
                                                                Padding="8,4" 
                                                                Style="{StaticResource PrimaryButton}" 
                                                                FontSize="11" 
                                                                Margin="0,0,5,0" 
                                                                Click="BtnModifyUser_Click"/>
                                                        <Button Content="Supprimer" 
                                                                Padding="8,4" 
                                                                Background="#D32F2F" 
                                                                Foreground="White" 
                                                                FontSize="11" 
                                                                BorderThickness="0" 
                                                                Cursor="Hand" 
                                                                Click="BtnDeleteUser_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- VOLET LATÉRAL DE L'ASSISTANT IA (SLIDING CHATBOT OVERLAY) -->
        <Grid Name="gridAiDrawerOverlay" Visibility="Collapsed" Panel.ZIndex="1000" Grid.RowSpan="4">
            <!-- Arrière-plan semi-transparent -->
            <Border Background="#80000000" MouseDown="GridAiDrawerOverlay_MouseDown"/>
            
            <!-- Panneau Chatbot à droite -->
            <Border HorizontalAlignment="Right" Width="440" Background="#F8F9FA" 
                    BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- En-tête -->
                        <RowDefinition Height="Auto"/> <!-- Puces de questions rapides -->
                        <RowDefinition Height="*"/>    <!-- Messages -->
                        <RowDefinition Height="Auto"/> <!-- Zone de saisie -->
                    </Grid.RowDefinitions>

                    <!-- En-tête du Chatbot -->
                    <Border Grid.Row="0" Background="#8B3A3A" Padding="16,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="White" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                                    <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Assistant IA Délibération" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Posez vos questions ou donnez vos consignes" Foreground="#E2E8F0" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="✕" Click="BtnCloseAiDrawer_Click" HorizontalAlignment="Right" 
                                    Background="Transparent" Foreground="White" FontSize="16" FontWeight="Bold" 
                                    BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <!-- Puces de questions rapides prédéfinies -->
                    <Border Grid.Row="1" Background="#EDF2F7" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🏆 Mentions Bien ?" Click="BtnQuickQuestion_Click" Tag="Combien d'étudiants ont eu une mention Bien ce semestre ?" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                <Button Content="📈 Taux de réussite ?" Click="BtnQuickQuestion_Click" Tag="Quel est le taux de réussite ?" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                <Button Content="📄 PV classe 3A40" Click="BtnQuickQuestion_Click" Tag="Génère-moi le PV de la classe 3A40" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                <Button Content="📊 Exporter Excel" Click="BtnQuickQuestion_Click" Tag="Exporte les admis en Excel" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Zone des messages du Chatbot -->
                    <ScrollViewer Name="scrollAiChat" Grid.Row="2" Padding="14" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="panelAiMessages">
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Zone de saisie du message Chatbot -->
                    <Border Grid.Row="3" Background="White" Padding="12" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtAiInput" Padding="10" FontSize="13"
                                     BorderBrush="#CBD5E1" BorderThickness="1"
                                     TextWrapping="Wrap" MaxHeight="80"
                                     KeyDown="TxtAiInput_KeyDown"
                                     ToolTip="Tapez votre question et appuyez sur Entrée..."/>
                            <Button Grid.Column="1" Content="Envoyer ➔" Click="BtnSendAiMessage_Click" 
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,8"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>