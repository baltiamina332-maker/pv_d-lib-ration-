<Window x:Class="DesktopApp.ClassesEtudiantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Classes et des Étudiants" 
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- ================= DESIGN SYSTEM : ROUGE CLAIR & BLANC ================= -->

        <!-- Style pour les cartes du Sidebar / Formulaires -->
        <Style x:Key="SidebarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8B0000" BlurRadius="10" ShadowDepth="2" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- En-tête de section dans les cartes -->
        <Style x:Key="CardHeaderBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#FFE4E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style pour les étiquettes Form -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Style moderne pour les TextBox (Formulaire Rouge Clair & Blanc) -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FDA4AF"/>
                                <Setter TargetName="border" Property="Background" Value="#FFF1F2"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#991B1B"/>
                                <Setter TargetName="border" Property="Background" Value="#FFF5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style moderne pour les ComboBox -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Bouton Principal Rouge (Bordeaux / Cramoisi) -->
        <Style x:Key="PrimaryRedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7F1D1D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton Secondaire Rouge Sombre -->
        <Style x:Key="SecondaryDarkRedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#700000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style modernisé pour les DataGrid -->
        <Style x:Key="CustomDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFDFD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- Style des en-têtes de colonnes DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
        </Style>

        <!-- Style des onglets Sub-Tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="14,8" Margin="0,0,6,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#991B1B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFF1F2"/>
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- En-tête principal -->
            <RowDefinition Height="Auto"/>
            <!-- Zone principale 2 colonnes -->
            <RowDefinition Height="*"/>
            <!-- Barre de statut -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= EN-TÊTE PRINCIPAL ROUGE ELEGANT ================= -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8B0000" Offset="0.0"/>
                    <GradientStop Color="#A51D24" Offset="0.5"/>
                    <GradientStop Color="#7F1D1D" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#7F1D1D" BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏫 " FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Classes &amp; Inscription des Étudiants" 
                                   FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Création de classes, inscription administrative et affectation des étudiants par filière" 
                               FontSize="12" Foreground="#FFE4E6" Margin="30,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="btnRafraichirHeader" Content="🔄 Rafraîchir Tout" 
                        Click="BtnRafraichir_Click"
                        Background="#B91C1C" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                        Padding="14,8" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnB" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnB" Property="Background" Value="#991B1B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ================= ZONE PRINCIPALE : SIDEBAR ROUGE CLAIR (GAUCHE) & TABLEAUX (DROITE) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Colonne 1 : Sidebar Formulaires Rouge Clair & Blanc -->
                <ColumnDefinition Width="390"/>
                <!-- Séparateur -->
                <ColumnDefinition Width="16"/>
                <!-- Colonne 2 : Tableaux à droite -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= GAUCHE : SIDEBAR FORMULAIRES (ROUGE CLAIR ET BLANC) ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Background="#FFF8F8" CornerRadius="14" Padding="14" BorderBrush="#FECDD3" BorderThickness="1">
                    <StackPanel>
                        
                        <!-- CARTE 1 : CRÉER UNE CLASSE -->
                        <Border Style="{StaticResource SidebarCardStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeaderBarStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏫 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Créer une Nouvelle Classe" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#8B0000" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bannière d'erreur classe -->
                                <Border Name="borderClasseError" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Name="txtClasseError" Foreground="#DC2626" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Code / Nom de la Classe -->
                                <TextBlock Text="Nom / Code Classe *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtNomClasse" Style="{StaticResource FormTextBoxStyle}" Tag="Ex: 3A40, 4TWIN1, 2GL2"/>

                                <!-- Niveau -->
                                <TextBlock Text="Niveau d'Étude" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Name="cmbNiveau" Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem Content="1ère Année (Tronc Commun)" IsSelected="True"/>
                                    <ComboBoxItem Content="2ème Année"/>
                                    <ComboBoxItem Content="3ème Année"/>
                                    <ComboBoxItem Content="4ème Année"/>
                                    <ComboBoxItem Content="5ème Année (Master / PFE)"/>
                                </ComboBox>

                                <!-- Filière -->
                                <TextBlock Text="Filière / Spécialité" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtFiliereClasse" Style="{StaticResource FormTextBoxStyle}" Tag="Ex: Génie Informatique, Web &amp; Internet"/>

                                <!-- Année Universitaire -->
                                <TextBlock Text="Année Universitaire" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtAnneeUniv" Style="{StaticResource FormTextBoxStyle}" Text="2025-2026"/>

                                <!-- Description -->
                                <TextBlock Text="Description / Remarques" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtDescriptionClasse" Style="{StaticResource FormTextBoxStyle}" Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>

                                <!-- Boutons Classe -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="btnCreerClasse" Content="➕ Créer la Classe" 
                                            Style="{StaticResource PrimaryRedButtonStyle}" 
                                            Click="BtnCreerClasse_Click"/>
                                    <Button Grid.Column="1" Name="btnAnnulerEditClasse" Content="❌ Annuler" Visibility="Collapsed"
                                            Click="BtnAnnulerEditClasse_Click" Margin="8,0,0,0" Padding="12,7"
                                            Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 2 : INSCRIRE UN ÉTUDIANT -->
                        <Border Style="{StaticResource SidebarCardStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeaderBarStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inscrire un Étudiant" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#8B0000" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bannière d'erreur étudiant -->
                                <Border Name="borderEtudiantError" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Name="txtEtudiantError" Foreground="#DC2626" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Classe cible -->
                                <TextBlock Text="Sélectionner la Classe *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Name="cmbClasseEtudiant" Style="{StaticResource FormComboBoxStyle}"/>

                                <!-- Nom et Prénom -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nom *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Name="txtNomEtudiant" Style="{StaticResource FormTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Prénom *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Name="txtPrenomEtudiant" Style="{StaticResource FormTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Matricule -->
                                <TextBlock Text="Matricule (Optionnel - Auto si vide)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtMatriculeEtudiant" Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Moyenne Générale et ECTS -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Moyenne Générale" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Name="txtMoyenneEtudiant" Style="{StaticResource FormTextBoxStyle}" Text="12.500"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ECTS Validés" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Name="txtEctsEtudiant" Style="{StaticResource FormTextBoxStyle}" Text="30"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Statut -->
                                <TextBlock Text="Statut de l'Étudiant" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Name="cmbStatutEtudiant" Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem Content="Nouveau" IsSelected="True"/>
                                    <ComboBoxItem Content="Ancien"/>
                                </ComboBox>

                                <!-- Boutons Inscrire Étudiant -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="btnInscrireEtudiant" Content="➕ Inscrire l'Étudiant" 
                                            Style="{StaticResource SecondaryDarkRedButtonStyle}"
                                            Click="BtnInscrireEtudiant_Click"/>
                                    <Button Grid.Column="1" Name="btnAnnulerEditEtudiant" Content="❌ Annuler" Visibility="Collapsed"
                                            Click="BtnAnnulerEditEtudiant_Click" Margin="8,0,0,0" Padding="12,7"
                                            Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ================= DROITE : TABLEAUX & BARRE D'OUTILS ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Barre d'outils et de filtres -->
                    <RowDefinition Height="Auto"/>
                    <!-- Contenu des Onglets (Étudiants / Classes) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRE D'OUTILS ELEGANTE -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍 Filtrer par Classe :" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" Name="cmbFiltreClasse" SelectionChanged="CmbFiltreClasse_SelectionChanged" Padding="8,5" BorderBrush="#CBD5E1"/>

                        <TextBox Grid.Column="3" Name="txtRecherche" TextChanged="TxtRecherche_TextChanged" Padding="10,6" Foreground="#64748B" Text="Rechercher par nom, prénom ou matricule..." BorderBrush="#CBD5E1" FontSize="12.5"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Name="btnActualiser" Content="🔄 Actualiser" Click="BtnRafraichir_Click" Padding="12,6" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Name="btnModifierSelection" Content="✏️ Modifier" Click="BtnModifierSelection_Click" Padding="12,6" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Name="btnSupprimerSelection" Content="🗑️ Supprimer" Click="BtnSupprimerSelection_Click" Padding="12,6" Background="#FFF5F5" Foreground="#C53030" BorderBrush="#FECDD3" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ONGLETS PRINCIPAUX & DATAGRIDS -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

                    <!-- Onglet 1 : Liste des Étudiants -->
                    <TabItem Header="🎓 Liste des Étudiants" FontSize="13.5">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,10,10,10" Padding="12">
                            <DataGrid Name="dgEtudiants" Style="{StaticResource CustomDataGridStyle}" MouseDoubleClick="DgEtudiants_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding NumeroOrdre}" Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="105"/>
                                    <DataGridTextColumn Header="Nom &amp; Prénom" Binding="{Binding NomPrenom}" Width="180">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Classe" Binding="{Binding ClasseGroupe}" Width="85"/>
                                    <DataGridTextColumn Header="Filière" Binding="{Binding Filiere}" Width="120"/>
                                    <DataGridTextColumn Header="Moyenne" Binding="{Binding MoyenneGenerale, StringFormat={}{0:0.000}}" Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Décision avec Badge Coloré -->
                                    <DataGridTemplateColumn Header="Décision" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="borderDec" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="txtDec" Text="{Binding Decision}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Decision}" Value="Admis">
                                                        <Setter TargetName="borderDec" Property="Background" Value="#DEF7EC"/>
                                                        <Setter TargetName="txtDec" Property="Foreground" Value="#03543F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Decision}" Value="Ajourné">
                                                        <Setter TargetName="borderDec" Property="Background" Value="#FEF3C7"/>
                                                        <Setter TargetName="txtDec" Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Decision}" Value="Rattrapage">
                                                        <Setter TargetName="borderDec" Property="Background" Value="#E0F2FE"/>
                                                        <Setter TargetName="txtDec" Property="Foreground" Value="#0369A1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Decision}" Value="Exclu">
                                                        <Setter TargetName="borderDec" Property="Background" Value="#FDE8E8"/>
                                                        <Setter TargetName="txtDec" Property="Foreground" Value="#9B1C1C"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" Width="110"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="80"/>
                                    <DataGridTextColumn Header="Date Création" Binding="{Binding DateCreation, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                                    
                                    <DataGridTemplateColumn Header="Actions" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✏️ Modifier" Click="BtnModifierEtudiantRow_Click" Padding="7,3" FontSize="11" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- Onglet 2 : Liste des Classes -->
                    <TabItem Header="🏫 Liste des Classes" FontSize="13.5">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,10,10,10" Padding="12">
                            <DataGrid Name="dgClasses" Style="{StaticResource CustomDataGridStyle}" MouseDoubleClick="DgClasses_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Nom / Code Classe" Binding="{Binding NomClasse}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#991B1B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Niveau" Binding="{Binding Niveau}" Width="160"/>
                                    <DataGridTextColumn Header="Filière" Binding="{Binding Filiere}" Width="160"/>
                                    <DataGridTextColumn Header="Année Univ." Binding="{Binding AnneeUniversitaire}" Width="110"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Date Création" Binding="{Binding DateCreation, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                                    <DataGridTemplateColumn Header="Actions" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✏️ Modifier" Click="BtnModifierClasseRow_Click" Padding="7,3" FontSize="11" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>

        <!-- ================= BARRE DE STATUT BAS ================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢 " FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Name="txtStatut" Text="Prêt | 0 classes et 0 étudiants chargés." Foreground="#334155" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Système de Délibération LMD &amp; Université" HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
