<Window x:Class="DesktopApp.AffectationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registre des Affectations - Enseignants &amp; Matières" 
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- ================= DESIGN SYSTEM : ROUGE CLAIR & BLANC ================= -->

        <!-- Style pour les cartes du Sidebar / Formulaires -->
        <Style x:Key="SidebarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8B0000" BlurRadius="10" ShadowDepth="2" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- En-tête de section dans les cartes -->
        <Style x:Key="CardHeaderBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#FFE4E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style pour les étiquettes Form -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Style moderne pour les TextBox (Formulaire Rouge Clair & Blanc) -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FDA4AF"/>
                                <Setter TargetName="border" Property="Background" Value="#FFF1F2"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#991B1B"/>
                                <Setter TargetName="border" Property="Background" Value="#FFF5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style moderne pour les ComboBox -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Bouton Principal Rouge (Bordeaux / Cramoisi) -->
        <Style x:Key="PrimaryRedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7F1D1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton Secondaire Rouge Sombre -->
        <Style x:Key="SecondaryDarkRedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#700000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style modernisé pour les DataGrid -->
        <Style x:Key="CustomDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFDFD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- Style des en-têtes de colonnes DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- En-tête principal -->
            <RowDefinition Height="Auto"/>
            <!-- Zone principale 2 colonnes -->
            <RowDefinition Height="*"/>
            <!-- Barre de statut -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= EN-TÊTE PRINCIPAL ROUGE ELEGANT ================= -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8B0000" Offset="0.0"/>
                    <GradientStop Color="#A51D24" Offset="0.5"/>
                    <GradientStop Color="#7F1D1D" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#7F1D1D" BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 " FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Registre des Affectations" 
                                   FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Gestion des affectations pédagogiques - Enseignants, Matières et Groupes" 
                               FontSize="12" Foreground="#FFE4E6" Margin="30,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="btnRafraichirHeader" Content="🔄 Rafraîchir Tout" 
                        Click="BtnRafraichir_Click"
                        Background="#B91C1C" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                        Padding="14,8" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnB" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnB" Property="Background" Value="#991B1B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ================= ZONE PRINCIPALE : SIDEBAR (GAUCHE) & TABLEAU (DROITE) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Colonne 1 : Sidebar Formulaires -->
                <ColumnDefinition Width="380"/>
                <!-- Séparateur -->
                <ColumnDefinition Width="16"/>
                <!-- Colonne 2 : Tableau à droite -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= GAUCHE : SIDEBAR FORMULAIRES ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Background="#FFF8F8" CornerRadius="14" Padding="14" BorderBrush="#FECDD3" BorderThickness="1">
                    <StackPanel>
                        <!-- CARTE : NOUVELLE AFFECTATION -->
                        <Border Style="{StaticResource SidebarCardStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeaderBarStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nouvelle Affectation" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#8B0000" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mode Édition -->
                                <Border Name="borderMode" Background="#EBF8FF" BorderBrush="#3182CE" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Name="txtModeFormulaire" Text="✏️ Mode Édition" Foreground="#1565C0" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Professeur -->
                                <TextBlock Text="👨‍🏫 Professeur" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBlock Text="Nom et Prénom *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Name="cmbEnseignant" IsEditable="True" Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem Content="Prof. Ben Ali Karim"/>
                                    <ComboBoxItem Content="Dr. Trabelsi Yasmine"/>
                                    <ComboBoxItem Content="Prof. Cherni Mohamed"/>
                                    <ComboBoxItem Content="Dr. Mansouri Salma"/>
                                    <ComboBoxItem Content="Prof. Jebali Youssef"/>
                                </ComboBox>

                                <!-- Matière -->
                                <TextBlock Text="📚 Matière / Module" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBlock Text="Nom de la matière *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtMatiere" Style="{StaticResource FormTextBoxStyle}" Tag="Ex: Développement Web, Base de Données"/>

                                <!-- Classe -->
                                <TextBlock Text="👥 Classe / Groupe" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBlock Text="Code de la classe *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Name="cmbClasse" IsEditable="True" Style="{StaticResource FormComboBoxStyle}"/>

                                <!-- Année Universitaire -->
                                <TextBlock Text="📅 Année Universitaire" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBlock Text="Année *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Name="txtAnneeUniv" Style="{StaticResource FormTextBoxStyle}" Text="2025-2026"/>

                                <!-- Boutons -->
                                <Button Name="btnEnregistrer" Content="💾 Enregistrer l'Affectation" 
                                        Style="{StaticResource PrimaryRedButtonStyle}" 
                                        Click="BtnEnregistrer_Click" Margin="0,8,0,8"/>
                                <Button Name="btnReinitialiser" Content="🔄 Réinitialiser" 
                                        Click="BtnReinitialiser_Click"
                                        Style="{StaticResource SecondaryDarkRedButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ================= DROITE : TABLEAU & BARRE D'OUTILS ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Barre d'outils et filtres -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tableau -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRE D'OUTILS ELEGANTE -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍 Filtre :" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" Name="cmbFiltreClasse" SelectionChanged="CmbFiltreClasse_SelectionChanged" Padding="8,5" BorderBrush="#CBD5E1"/>

                        <TextBox Grid.Column="2" Name="txtRecherche" TextChanged="TxtRecherche_TextChanged" Padding="10,6" Foreground="#64748B" Text="Rechercher..." BorderBrush="#CBD5E1" FontSize="12" Margin="12,0,0,0"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Name="btnActualiser" Content="🔄 Actualiser" Click="BtnRafraichir_Click" 
                                    Padding="12,6" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Name="btnEditer" Content="✏️ Modifier" Click="BtnEditer_Click"
                                    Padding="12,6" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Name="btnSupprimer" Content="🗑️ Supprimer" Click="BtnSupprimer_Click"
                                    Padding="12,6" Background="#FFF5F5" Foreground="#C53030" BorderBrush="#FECDD3" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TABLEAU DES AFFECTATIONS -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <DataGrid Name="dgAffectations" Style="{StaticResource CustomDataGridStyle}" SelectionChanged="DgAffectations_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Enseignant" Binding="{Binding Enseignant}" Width="150"/>
                            <DataGridTextColumn Header="Matière" Binding="{Binding Matiere}" Width="180"/>
                            <DataGridTextColumn Header="Classe" Binding="{Binding NomClasse}" Width="90"/>
                            <DataGridTextColumn Header="Année" Binding="{Binding AnneeUniversitaire}" Width="90"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="80"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateAffectation, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= BARRE DE STATUT ================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
            <TextBlock Name="txtStatut" Text="✅ Prêt | 0 affectation(s) enregistrée(s)" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
