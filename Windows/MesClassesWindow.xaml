<Window x:Class="DesktopApp.MesClassesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mes Classes Attribuées &amp; Étudiants (Espace Enseignant)" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <!-- Style pour DataGrid -->
        <Style x:Key="CustomDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <!-- Style rouge pour TextBox -->
        <Style x:Key="RedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8B3A3A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6B2A2A"/>
                                <Setter Property="Background" Value="#FEF7F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#A94442"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style rouge pour ComboBox -->
        <Style x:Key="RedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8B3A3A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- En-tête principal -->
            <RowDefinition Height="Auto"/>
            <!-- Barre de filtres et recherche -->
            <RowDefinition Height="Auto"/>
            <!-- Zone des Tableaux (Onglets) -->
            <RowDefinition Height="*"/>
            <!-- Barre de statut -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE DE LA FENÊTRE -->
        <Border Grid.Row="0" Background="#8B3A3A" CornerRadius="8" Padding="18,14" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="👨‍🏫 Mes Classes Attribuées &amp; Étudiants (Lecture Seule)" 
                               FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Espace Enseignant • Consultation des étudiants et classes qui vous sont officiellement attribuées" 
                               FontSize="12" Foreground="#F8F9FA" Margin="0,3,0,0" Opacity="0.95"/>
                </StackPanel>

                <Button Grid.Column="1" Name="btnRafraichirHeader" Content="🔄 Rafraîchir" 
                        Click="BtnRafraichir_Click"
                        Background="#6B2C2C" Foreground="White" FontWeight="SemiBold" 
                        Padding="14,7" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- BARRE DE RECHERCHE ET FILTRES -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🏫 Mes Classes Attribuées :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" Name="cmbFiltreClasse" SelectionChanged="CmbFiltreClasse_SelectionChanged" Style="{StaticResource RedComboBoxStyle}"/>

                <TextBox Grid.Column="3" Name="txtRecherche" TextChanged="TxtRecherche_TextChanged" Style="{StaticResource RedTextBoxStyle}" Foreground="#718096" Text="Rechercher un étudiant par nom, prénom ou matricule..."/>

                <Button Grid.Column="4" Name="btnActualiser" Content="🔄 Recharger" Click="BtnRafraichir_Click" Padding="14,7" Background="#EDF2F7" Foreground="#2D3748" BorderBrush="#CBD5E0" BorderThickness="1" Margin="10,0,0,0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- TABLEAUX EN ONGLET (LECTURE SEULE) -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- Onglet 1 : Liste des Étudiants de Mes Classes -->
            <TabItem Header="🎓 Étudiants Inscrits (Lecture Seule)" FontSize="14" FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,8,8,8" Padding="12">
                    <DataGrid Name="dgEtudiants" Style="{StaticResource CustomDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding NumeroOrdre}" Width="45"/>
                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="110"/>
                            <DataGridTextColumn Header="Nom &amp; Prénom" Binding="{Binding NomPrenom}" Width="200"/>
                            <DataGridTextColumn Header="Classe" Binding="{Binding ClasseGroupe}" Width="100"/>
                            <DataGridTextColumn Header="Filière" Binding="{Binding Filiere}" Width="140"/>
                            <DataGridTextColumn Header="Moyenne" Binding="{Binding MoyenneGenerale, StringFormat={}{0:0.000}}" Width="90"/>
                            <DataGridTextColumn Header="Décision" Binding="{Binding Decision}" Width="120"/>
                            <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" Width="120"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Onglet 2 : Mes Classes Attribuées -->
            <TabItem Header="🏫 Mes Classes Attribuées (Lecture Seule)" FontSize="14" FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,8,8,8" Padding="12">
                    <DataGrid Name="dgClasses" Style="{StaticResource CustomDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Code Classe" Binding="{Binding NomClasse}" Width="150"/>
                            <DataGridTextColumn Header="Niveau" Binding="{Binding Niveau}" Width="180"/>
                            <DataGridTextColumn Header="Filière" Binding="{Binding Filiere}" Width="180"/>
                            <DataGridTextColumn Header="Année Universitaire" Binding="{Binding AnneeUniversitaire}" Width="140"/>
                            <DataGridTextColumn Header="Description / Remarques" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- BARRE DE STATUT -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <TextBlock Name="txtStatut" Text="Prêt | Espace Enseignant (Mode Consultation)." Foreground="#4A5568" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="🔒 Mode Lecture Seule — Modifications réservées à l'Administration" HorizontalAlignment="Right" Foreground="#718096" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
