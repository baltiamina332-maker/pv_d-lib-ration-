<Window x:Class="DesktopApp.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réinitialisation du Mot de Passe - PV Generator" 
        Height="540" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="RoundedInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="RoundedPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="White" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#25000000" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Panneau Gauche : Thème Bordeaux Décoratif -->
                <ColumnDefinition Width="1*"/>
                <!-- Panneau Droit : Formulaire de Récupération -->
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- PANNEAU GAUCHE (BORDEAUX) -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B3A3A" Offset="0"/>
                        <GradientStop Color="#6B2A2A" Offset="0.55"/>
                        <GradientStop Color="#4A1C1C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Formes décoratives -->
                    <Path Data="M 0,0 C 120,0 150,100 0,160 Z" Fill="White" Opacity="0.15"/>
                    <Path Data="M 0,550 C 150,550 200,450 0,380 Z" Fill="#2C0F0F" Opacity="0.45"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#FDF2F2" BorderBrush="#8B3A3A" BorderThickness="3" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="🔑" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Récupération de Compte" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,5" TextAlignment="Center"/>
                        <TextBlock Text="Réinitialisez votre mot de passe en toute sécurité" FontSize="12" Foreground="#F87171" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANNEAU DROIT (FORMULAIRE RÉINITALISATION) -->
            <Border Grid.Column="1" Background="White" CornerRadius="0,20,20,0" ClipToBounds="True">
                <Grid>
                    <!-- Bouton Fermer (✕) -->
                    <Button Content="✕" Click="BtnClose_Click" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Margin="0,15,15,0" Width="32" Height="32" 
                            Background="Transparent" Foreground="#64748B" 
                            FontSize="16" FontWeight="Bold" BorderThickness="0" 
                            Cursor="Hand" ToolTip="Fermer"/>

                    <Grid Margin="35,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titre principal -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="MOT DE PASSE OUBLIÉ" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Name="txtStepSubtitle" Text="Étape 1 : Entrez votre nom d'utilisateur ou votre adresse email" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Zone Alerte / Erreur globale -->
                        <Border Grid.Row="1" Name="borderError" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock Name="txtError" Text="" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ZONE DE CONTENU DES ÉTAPES -->
                        <Grid Grid.Row="2">
                            <!-- ÉTAPE 1 : Recherche de l'utilisateur -->
                            <StackPanel Name="panelStep1" Visibility="Visible">
                                <TextBlock Text="Nom d'utilisateur ou Adresse Email *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Name="borderIdentifier" Height="46" CornerRadius="23" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="18,0" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="txtIdentifier" Style="{StaticResource RoundedInputStyle}" TextChanged="TxtIdentifier_TextChanged"/>
                                        <TextBlock Grid.Column="1" Text="👤" FontSize="16" Foreground="#8B3A3A" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="💡 Un code de confirmation sera généré pour valider la réinitialisation." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- ÉTAPE 2 : Code de Sécurité / OTP -->
                            <StackPanel Name="panelStep2" Visibility="Collapsed">
                                <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                                    <TextBlock Name="txtCodeNotice" Text="Un code de sécurité à 6 chiffres a été généré pour le compte :" Foreground="#1E40AF" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Text="Code de validation à 6 chiffres *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Name="borderCode" Height="46" CornerRadius="23" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="18,0" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="txtSecurityCode" Style="{StaticResource RoundedInputStyle}" TextChanged="TxtSecurityCode_TextChanged" MaxLength="6"/>
                                        <TextBlock Grid.Column="1" Text="🔢" FontSize="16" Foreground="#8B3A3A" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ÉTAPE 3 : Nouveau mot de passe -->
                            <StackPanel Name="panelStep3" Visibility="Collapsed">
                                <TextBlock Text="Nouveau mot de passe *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Name="borderNewPassword" Height="44" CornerRadius="22" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="16,0" Margin="0,0,0,12">
                                    <Grid>
                                        <PasswordBox Name="pwdNewPassword" Style="{StaticResource RoundedPasswordStyle}" PasswordChanged="PwdNewPassword_PasswordChanged"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Confirmer le nouveau mot de passe *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Name="borderConfirmPassword" Height="44" CornerRadius="22" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="16,0" Margin="0,0,0,12">
                                    <Grid>
                                        <PasswordBox Name="pwdConfirmPassword" Style="{StaticResource RoundedPasswordStyle}" PasswordChanged="PwdConfirmPassword_PasswordChanged"/>
                                    </Grid>
                                </Border>

                                <TextBlock Name="txtPasswordMatchStatus" Text="• Le mot de passe doit comporter au moins 4 caractères." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- ÉTAPE 4 : Succès -->
                            <StackPanel Name="panelStep4" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="🎉 Réinitialisation Réussie !" FontSize="18" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Votre mot de passe a été mis à jour avec succès. Vous pouvez maintenant vous connecter avec vos nouveaux identifiants." FontSize="13" Foreground="#374151" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- BOUTONS D'ACTION (BAS) -->
                        <Grid Grid.Row="3" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Name="btnBack" Content="← Retour" Click="BtnBack_Click" 
                                    Height="42" Padding="15,0" Foreground="#475569" FontSize="13" FontWeight="SemiBold" 
                                    Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Visibility="Collapsed"/>

                            <Button Grid.Column="1" Name="btnNext" Content="RECHERCHER LE COMPTE" Click="BtnNext_Click" 
                                    Height="42" Foreground="White" FontSize="13" FontWeight="Bold" 
                                    BorderThickness="0" Cursor="Hand" Margin="10,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#8B3A3A" Offset="0"/>
                                                    <GradientStop Color="#6B2A2A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="21">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="#8B3A3A" Opacity="0.3"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
