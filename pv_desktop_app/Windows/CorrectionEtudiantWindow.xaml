<Window x:Class="DesktopApp.CorrectionEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correction Manuelle d'Étudiant" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✏️ Correction Manuelle" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50" 
                       HorizontalAlignment="Center"/>
            <TextBlock Name="txtEtudiantInfo" 
                       Text="Étudiant: [Nom] - [Matricule]" 
                       FontSize="14" 
                       Foreground="#6C757D" 
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Informations actuelles -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#DEE2E6" 
                BorderThickness="1" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📊 Valeurs Actuelles" 
                           FontWeight="SemiBold" 
                           FontSize="14" 
                           Foreground="#2C3E50" 
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Moyenne:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Name="txtMoyenneActuelle" Text="--" Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Décision:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="txtDecisionActuelle" Text="--" Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mention:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Name="txtMentionActuelle" Text="--" Margin="0,0,0,5"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Formulaire de correction -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#DEE2E6" 
                BorderThickness="1" 
                Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="✏️ Nouvelles Valeurs" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="#2C3E50" 
                               Margin="0,0,0,15"/>

                    <!-- Nouvelle décision -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Nouvelle Décision" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Name="cmbNouvelleDecision" Padding="8">
                            <ComboBoxItem Content="(Pas de changement)"/>
                            <ComboBoxItem Content="Admis"/>
                            <ComboBoxItem Content="Admis avec modération"/>
                            <ComboBoxItem Content="Ajourné"/>
                            <ComboBoxItem Content="Conseil d'École"/>
                            <ComboBoxItem Content="Redouble / Exclu"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Nouvelle mention -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Nouvelle Mention" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Name="cmbNouvelleMention" Padding="8">
                            <ComboBoxItem Content="(Pas de changement)"/>
                            <ComboBoxItem Content="Très Bien"/>
                            <ComboBoxItem Content="Bien"/>
                            <ComboBoxItem Content="Assez Bien"/>
                            <ComboBoxItem Content="Passable"/>
                            <ComboBoxItem Content="Session de rattrapage"/>
                            <ComboBoxItem Content="À valider par le Conseil"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Nouvelle observation -->
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Nouvelle Observation / Justification" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox Name="txtNouvelleObservation" 
                                     Padding="8" 
                                     Height="80" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="TxtNouvelleObservation_TextChanged"/>
                            <TextBlock Name="txtPlaceholder" 
                                       Text="Saisir la raison de la correction manuelle..."
                                       Padding="10,10,8,8"
                                       Foreground="#999999"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,0">
            <Button Name="btnValider" 
                    Content="✅ Valider les Corrections" 
                    Click="BtnValider_Click"
                    Background="#28A745"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="20,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,15,0"/>
            <Button Name="btnAnnuler" 
                    Content="❌ Annuler" 
                    Click="BtnAnnuler_Click"
                    Background="#6C757D"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="20,10"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>