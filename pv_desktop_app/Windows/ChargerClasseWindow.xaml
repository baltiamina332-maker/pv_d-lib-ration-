<Window x:Class="DesktopApp.ChargerClasseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charger Étudiants par Classe" 
        Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📚 Charger Étudiants par Classe" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Sélectionnez une classe pour charger les étudiants depuis la base de données" 
                       FontSize="12" 
                       Foreground="#6C757D" 
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Formulaire -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#DEE2E6" 
                BorderThickness="1" 
                Padding="20">
            <StackPanel>
                <!-- Classe -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Code de Classe *" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <ComboBox Name="cmbClasse" 
                              IsEditable="True"
                              Padding="10"
                              FontSize="14">
                        <ComboBoxItem Content="3A40"/>
                        <ComboBoxItem Content="3A41"/>
                        <ComboBoxItem Content="3A42"/>
                        <ComboBoxItem Content="2A30"/>
                        <ComboBoxItem Content="2A31"/>
                        <ComboBoxItem Content="2A32"/>
                        <ComboBoxItem Content="1A20"/>
                        <ComboBoxItem Content="1A21"/>
                        <ComboBoxItem Content="1A22"/>
                    </ComboBox>
                    <TextBlock Text="Exemples: 3A40, 2A31, 1A22, etc." 
                               FontSize="11" 
                               Foreground="#999" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Session (optionnel) -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Session (Optionnel)" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <ComboBox Name="cmbSession" 
                              Padding="10"
                              FontSize="14">
                        <ComboBoxItem Content="(Toutes les sessions)" IsSelected="True"/>
                        <ComboBoxItem Content="1 - Session Principale"/>
                        <ComboBoxItem Content="2 - Session Rattrapage"/>
                    </ComboBox>
                </StackPanel>

                <!-- Options -->
                <StackPanel>
                    <CheckBox Name="chkRecalculerDecisions" 
                              Content="Recalculer automatiquement les décisions après chargement"
                              FontSize="13"
                              IsChecked="True"
                              Margin="0,0,0,5"/>
                    <CheckBox Name="chkAfficherStatistiques" 
                              Content="Afficher les statistiques après chargement"
                              FontSize="13"
                              IsChecked="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,0">
            <Button Name="btnCharger" 
                    Content="📚 Charger les Étudiants" 
                    Click="BtnCharger_Click"
                    Background="#8B3A3A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="20,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,15,0"/>
            <Button Name="btnAnnuler" 
                    Content="❌ Annuler" 
                    Click="BtnAnnuler_Click"
                    Background="#6C757D"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="20,10"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>