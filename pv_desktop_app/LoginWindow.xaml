<Window x:Class="DesktopApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PV-Delib - Connexion" 
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    
    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8B3A3A"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
                <Trigger Property="Tag" Value="Error">
                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#FFEBEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8B3A3A"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
                <Trigger Property="Tag" Value="Error">
                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#FFEBEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="25">
        <!-- Floating Auth Card -->
        <Border Background="White" 
                CornerRadius="14" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                Padding="35,30">
            <StackPanel VerticalAlignment="Center">
                
                <!-- Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                    <Border Width="52" Height="52" 
                            Background="#8B3A3A" 
                            CornerRadius="12" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,12">
                        <TextBlock Text="📄" FontSize="24" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PV-Delib" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Connectez-vous pour accéder à votre espace" 
                               FontSize="12.5" 
                               Foreground="#64748B" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Error Alert Box -->
                <Border Name="borderError"
                        Background="#FDEDEC"
                        BorderBrush="#C0392B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,15"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " Foreground="#C0392B" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Name="txtError" 
                                   Text="" 
                                   Foreground="#922B21" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Nom d'utilisateur -->
                <TextBlock Text="Nom d'utilisateur" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2C3E50" 
                           Margin="0,0,0,6"/>
                <TextBox Name="txtUsername" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"/>

                <!-- Mot de passe -->
                <TextBlock Text="Mot de passe" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2C3E50" 
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <PasswordBox Name="pwdPassword" 
                                 Style="{StaticResource ModernPasswordBox}"/>
                    <TextBox Name="txtPasswordVisible" 
                             Style="{StaticResource ModernTextBox}" 
                             Visibility="Collapsed"/>
                    <Button Name="btnTogglePassword"
                            Content="👁️"
                            Click="BtnTogglePassword_Click"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,0"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="Afficher/Masquer le mot de passe"/>
                </Grid>

                <!-- Bouton Connexion -->
                <Button Name="btnLogin" 
                        Click="BtnLogin_Click"
                        Background="#8B3A3A"
                        Foreground="White"
                        FontSize="14.5"
                        FontWeight="Bold"
                        Padding="0,12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="➔  Se connecter" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Annuler / Fermer -->
                <Button Name="btnCancel" 
                        Content="Annuler" 
                        Click="BtnCancel_Click"
                        Background="Transparent"
                        Foreground="#64748B"
                        FontSize="13"
                        Padding="0,6"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <!-- Footer info -->
                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,12,0,0">
                    <TextBlock Text="Système LMD de Gestion des Délibérations • ESPRIT" 
                               FontSize="11" 
                               Foreground="#94A3B8" 
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
