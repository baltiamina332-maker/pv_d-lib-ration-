<Application x:Class="DesktopApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Palettes de couleurs universitaires professionnelles -->
        <!-- Couleurs principales -->
        <Color x:Key="ColorBordeaux">#8B3A3A</Color>
        <Color x:Key="ColorBordeauxLight">#A85050</Color>
        <Color x:Key="ColorBordeauxDark">#6B2C2C</Color>
        <Color x:Key="ColorGrisLight">#F0F2F5</Color>
        <Color x:Key="ColorGrisMedium">#E8EAED</Color>
        <Color x:Key="ColorGrisDark">#5F6368</Color>
        <Color x:Key="ColorAccent">#4A90E2</Color>
        
        <!-- Ressources de couleurs -->
        <SolidColorBrush x:Key="BrushBordeaux" Color="#8B3A3A"/>
        <SolidColorBrush x:Key="BrushBordeauxLight" Color="#A85050"/>
        <SolidColorBrush x:Key="BrushBordeauxDark" Color="#6B2C2C"/>
        <SolidColorBrush x:Key="BrushGrisLight" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="BrushGrisMedium" Color="#E8EAED"/>
        <SolidColorBrush x:Key="BrushGrisDark" Color="#5F6368"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#4A90E2"/>

        <!-- Style Bouton Principal (Bordeaux) -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#8B3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A85050"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#6B2C2C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D3D3D3"/>
                    <Setter Property="Foreground" Value="#999999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Bouton Secondaire (Gris) -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#5F6368"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#757575"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#424242"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Bouton Accent (Bleu) -->
        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4A90E2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Bouton Succès (Vert) -->
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style TextBlock Titre -->
        <Style TargetType="TextBlock" x:Key="Title">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Style TextBlock Sous-titre -->
        <Style TargetType="TextBlock" x:Key="SubTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Style TextBlock Texte normal -->
        <Style TargetType="TextBlock" x:Key="BodyText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="LineHeight" Value="1.5"/>
        </Style>
    </Application.Resources>
</Application>
